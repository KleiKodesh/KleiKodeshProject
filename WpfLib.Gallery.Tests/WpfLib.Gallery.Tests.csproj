<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Visual regression tests for the palette.

    The gallery is the fixture: it already puts every style on screen in four
    Office themes, so the tests only have to drive it and photograph it.

    FlaUI (UIAutomation) does the driving. It finds controls by name and
    control type rather than by screen coordinates, which matters: a capture
    keyed to coordinates photographs whatever window happens to be on top,
    which is exactly how earlier manual attempts kept grabbing the editor
    instead of the app.

    Verify does the comparing. It diffs binary files, so a PNG that shifts by
    a pixel fails the test and writes a .received.png next to the .verified.png
    for inspection.

    net10.0-windows here even though the gallery is net48. The tests launch the
    gallery as a separate process, so the two never share a runtime.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- UIAutomation must be driven from an STA thread. -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\xunit.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Verify.Xunit" Version="28.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build the gallery first so the exe under test is always current. -->
    <ProjectReference Include="..\WpfLib.Gallery\WpfLib.Gallery.csproj"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=net48" />
  </ItemGroup>

</Project>

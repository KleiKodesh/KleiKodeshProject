<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!--
      One test process, one gallery. The visual tests share a rendered set and
      the behaviour tests share a live window, so running them in parallel would
      have them fighting over the same app.

      There is deliberately no ExecutionThreadApartmentState here: it is ignored
      on .NET 10 and only prints a warning. The tests that need STA - the
      ComboBoxFilter ones, which construct real WPF controls - create their own
      STA thread.
    -->
    <MaxCpuCount>1</MaxCpuCount>
  </RunConfiguration>
</RunSettings>

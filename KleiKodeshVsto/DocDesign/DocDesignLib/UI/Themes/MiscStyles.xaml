<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:WpfLib.Converters;assembly=WpfLib"
                    xmlns:controls="clr-namespace:WpfLib.Controls;assembly=WpfLib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WpfLib;component/themes/typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <converters:ReverseBoolConverter x:Key="ReverseBoolConverter"/>

    <!-- ── TextBlock ─────────────────────────────────────────────── -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize"          Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="FontFamily"        Value="{StaticResource UiFontFamily}"/>
    </Style>

    <!-- CheckBox comes from WpfLib/Themes/CheckBoxStyles.xaml (via OfficePalette). -->

    <!-- ── Separator ─────────────────────────────────────────────── -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="#50808080"/>
        <Setter Property="Margin"     Value="0,2"/>
    </Style>

    <!-- UpDownTextBox and UpDownFloatTextBox come from
         WpfLib/Themes/UpDownTextBoxStyles.xaml. -->

    <!-- ── Delete overlay — red diagonal line (same as RegexFindLib FormatToggle false state) ── -->
    <!-- Usage: add as a sibling inside a Grid alongside the icon Viewbox -->
    <Style x:Key="DeleteOverlay" TargetType="Canvas">
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Scrollbars come from WpfLib/Themes/ScrollBarStyles.xaml (merged in DocDesignDictionary). -->

</ResourceDictionary>

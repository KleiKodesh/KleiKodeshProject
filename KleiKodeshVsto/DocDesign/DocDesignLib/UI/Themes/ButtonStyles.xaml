<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Merged here, not only in DocDesignDictionary, so the BasedOn keys below
         resolve inside this dictionary rather than relying on a sibling. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WpfLib;component/themes/buttonstyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Icon button — IconButton at this pane's 36px toolbar size. -->
    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width"  Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="1,0"/>
        <Style.Resources>
            <Style TargetType="Path" BasedOn="{StaticResource IconPath}"/>
        </Style.Resources>
    </Style>

    <!-- ── Reset button (= icon) ─────────────────────────────────── -->
    <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="ToolTip"  Value="איפוס"/>
        <Setter Property="Width"    Value="26"/>
        <Setter Property="Height"   Value="26"/>
        <Setter Property="Padding"  Value="5"/>
        <Style.Resources>
            <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                <Setter Property="Data"          Value="M5 2.5a.5.5 0 0 0-1 0v4.9a.6.6 0 0 0 .6.6h4.9a.5.5 0 0 0 0-1H5.906l3.473-3.019a4 4 0 0 1 5.248 6.038l-8.172 7.104a.5.5 0 0 0 .656.754l8.172-7.103a5 5 0 0 0-6.56-7.547L5 6.463z"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- ── Increase / Decrease repeat buttons ────────────────────── -->
    <Style x:Key="IncreaseButton" TargetType="RepeatButton">
        <Setter Property="ToolTip"          Value="הגדל"/>
        <Setter Property="Margin"           Value="0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="MinWidth"         Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"/>
        <Style.Resources>
            <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                <Setter Property="Margin"        Value="5"/>
                <Setter Property="Width"         Value="10"/>
                <Setter Property="Data"          Value="M10 2.5a.5.5 0 0 1 .5.5v6.5H17a.5.5 0 0 1 0 1h-6.5V17a.5.5 0 0 1-1 0v-6.5H3a.5.5 0 0 1 0-1h6.5V3a.5.5 0 0 1 .5-.5"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="DecreaseButton" TargetType="RepeatButton">
        <Setter Property="ToolTip"          Value="הקטן"/>
        <Setter Property="Margin"           Value="0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="MinWidth"         Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"/>
        <Style.Resources>
            <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                <Setter Property="Margin"        Value="5"/>
                <Setter Property="Width"         Value="10"/>
                <Setter Property="Data"          Value="M3 10a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13A.5.5 0 0 1 3 10"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- Toggle — IconToggle deliberately, so a checked toggle shows no accent.
         Use CheckedToggle for toggles that should show their state. -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
        <Setter Property="Padding"    Value="8,4"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- CheckedToggle comes from WpfLib/Themes/ButtonStyles.xaml. -->

</ResourceDictionary>

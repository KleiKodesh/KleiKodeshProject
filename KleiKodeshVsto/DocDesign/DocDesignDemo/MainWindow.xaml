<Window SizeToContent="WidthAndHeight" x:Class="DocDesignDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocDesign Demo"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="#FFFFFF">

    <!--
        Hosts DocDesignView directly as a WPF UserControl.
        In production it lives inside a WindowsFormsHost inside a VSTO task pane.
        Toggle the commented Background/Foreground lines to test dark mode.
    -->
    <!-- Content = a Word task pane at width 600 px: 400 x 452 DIPs, measured live in Word at 150%. -->
    <Border x:Name="ViewHost" Width="400" Height="452" BorderThickness="0"/>

</Window>

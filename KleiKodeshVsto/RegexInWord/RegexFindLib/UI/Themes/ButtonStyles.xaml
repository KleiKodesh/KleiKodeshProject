<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:kk="http://schemas.kleikodesh.org/wpf"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Merged here, not only in RegexFindDictionary, so the BasedOn keys below
         resolve inside this dictionary rather than relying on a sibling. -->
    <ResourceDictionary.MergedDictionaries>
        <kk:SharedResourceDictionary Source="/WpfLib;component/themes/buttonstyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        This pane's buttons are WpfLib's, at this pane's sizes. The look, the
        hover and pressed overlays and the checked behaviour all live in
        WpfLib/Themes/ButtonStyles.xaml; only the metrics are local.
    -->

    <!-- ── Icon button inside an input wrapper ───────────────────── -->
    <Style x:Key="InputIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="28"/>
    </Style>

    <!-- ── Plain format button (clear / copy) ────────────────────── -->
    <Style x:Key="FormatButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width"   Value="28"/>
        <Setter Property="Height"  Value="28"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <!-- ── Icon toggle inside an input wrapper ───────────────────── -->
    <Style x:Key="InputIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource AccentToggle}">
        <Setter Property="Width" Value="28"/>
    </Style>

    <!-- ── Small icon-only toggle (regex palette, etc.) ──────────────
         Named for where it is used rather than IconToggle, because WpfLib's
         IconToggle is the variant with NO checked highlight and this one is
         the opposite. Same name, opposite behaviour would be a trap.
    -->
    <Style x:Key="PaletteToggle" TargetType="ToggleButton" BasedOn="{StaticResource AccentToggle}">
        <Setter Property="Width"  Value="28"/>
        <Setter Property="Height" Value="28"/>
    </Style>

</ResourceDictionary>

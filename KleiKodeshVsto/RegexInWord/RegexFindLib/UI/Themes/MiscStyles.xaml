<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:kk="http://schemas.kleikodesh.org/wpf"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WpfLib.Controls;assembly=WpfLib">
    <ResourceDictionary.MergedDictionaries>
        <kk:SharedResourceDictionary Source="/WpfLib;component/themes/themedcontrol.xaml"/>
        <kk:SharedResourceDictionary Source="/WpfLib;component/themes/brushes.xaml"/>
        <kk:SharedResourceDictionary Source="/WpfLib;component/themes/typography.xaml"/>
        <kk:SharedResourceDictionary Source="/WpfLib;component/themes/textinputstyles.xaml"/>
        <kk:SharedResourceDictionary Source="/WpfLib;component/themes/liststyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!-- UpDownTextBox comes from WpfLib/Themes/UpDownTextBoxStyles.xaml. -->

    <!-- ── Search input TextBox — borderless, fills the input wrapper ──── -->
    <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource FlatTextBox}">
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <!-- ── Input wrapper border — adaptive ───────────────────────── -->
    <Style x:Key="InputWrapper" TargetType="Border">
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="4"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Height"          Value="32"/>
    </Style>

    <!-- ── Inline TextBox — inherits fg from ancestor ────────────── -->
    <Style x:Key="InlineTextBox" TargetType="TextBox" BasedOn="{StaticResource FlatTextBox}">
        <Setter Property="Padding" Value="8,0"/>
    </Style>

    <!-- ── Result list item — hover/pressed/selected ────────────── -->
    <Style x:Key="ResultItem" TargetType="ListBoxItem" BasedOn="{StaticResource OfficeListBoxItem}">
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <!-- Scrollbars come from WpfLib/Themes/ScrollBarStyles.xaml (via OfficePalette). -->

</ResourceDictionary>

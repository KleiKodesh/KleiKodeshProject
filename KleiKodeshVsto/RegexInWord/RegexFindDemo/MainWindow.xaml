<Window SizeToContent="WidthAndHeight" x:Class="RegexFindDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RegexFind Demo"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="#FFFFFF">

    <!-- Host the RegexFindView directly as a WPF UserControl.
         In production it lives inside a WindowsFormsHost inside a VSTO task pane,
         but for debugging the UI we can host it directly in a WPF window. -->
    <!-- Content = a Word task pane at width 600 px: 400 x 452 DIPs, measured live in Word at 150%. -->
    <Border x:Name="ViewHost" Width="400" Height="452"
            BorderThickness="0"/>

</Window>

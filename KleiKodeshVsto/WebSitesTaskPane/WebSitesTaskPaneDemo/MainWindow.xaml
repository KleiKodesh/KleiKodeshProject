<Window SizeToContent="WidthAndHeight" x:Class="WebSitesTaskPaneDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:websiteslib="clr-namespace:WebSitesTaskPane.UI;assembly=WebSitesTaskPane"
        Title="WebSitesTaskPane Demo"
        WindowStartupLocation="CenterScreen">
    <!-- Content = a Word task pane at width 600 px: 400 x 452 DIPs, measured live in Word at 150%. -->
    <Grid Width="400" Height="452" >
        <websiteslib:WebSitesView />
    </Grid>
</Window>

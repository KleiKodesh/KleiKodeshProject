<!-- NakdanView.xaml  |  Hebrew vowelization task-pane  |  RTL  |  MVVM -->
<UserControl x:Class="Nakdan.UI.NakdanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Nakdan.UI"
             xmlns:p="clr-namespace:Nakdan.Properties"
             xmlns:conv="clr-namespace:WpfLib.Converters;assembly=WpfLib"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="300"
             FlowDirection="{x:Static p:Strings.ChromeFlowDirection}"
             FontFamily="Segoe UI"
             FontSize="13"
             Background="White"
             Foreground="Black">
    <!--
        Background must be set (not Transparent) so ComboBox dropdown popups work correctly.
        ElementHost overrides this with the Office theme color at runtime.
    -->

    <UserControl.DataContext>
        <local:NakdanViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="NakdanDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ── Converters ────────────────────────────────────── -->
            <conv:BoolToVisibilityConverter  x:Key="BoolToVis"/>
            <local:GenreDescriptionConverter  x:Key="GenreDesc"/>

        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════
         ROOT
    ═══════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,12,12,12">

            <!-- ─────────────────────────────────────────────────
                 SECTION LABEL: VOWELIZE ACTIONS
            ───────────────────────────────────────────────── -->
            <TextBlock Text="{x:Static p:Strings.Section_Actions}"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,0,0,8"/>

            <!-- Vowelize selection -->
            <Button Style="{StaticResource ActionButton}"
                    Command="{Binding VowelizeSelectionCommand}"
                    Margin="0,0,0,12"
                    ToolTip="{x:Static p:Strings.Tip_Vowelize}">
                <TextBlock Text="{x:Static p:Strings.Action_Vowelize}" VerticalAlignment="Center"/>
            </Button>

            <!-- Clean selection: one button + dropdown of what to remove -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding CleanTextCommand}"
                        ToolTip="{x:Static p:Strings.Tip_Clean}">
                    <TextBlock Text="{x:Static p:Strings.Action_Clean}" VerticalAlignment="Center"/>
                </Button>
                <ToggleButton x:Name="CleanOptionsToggle"
                              Grid.Column="1"
                              Style="{StaticResource CheckedToggle}"
                              Background="#0F808080"
                              Width="28"
                              Padding="7"
                              Margin="4,0,0,0"
                              ToolTip="{x:Static p:Strings.Tip_CleanChoose}">
                    <Path Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          Data="M4.21967 6.96967C4.51256 6.67678 4.98744 6.67678 5.28033 6.96967L10 11.6893L14.7197 6.96967C15.0126 6.67678 15.4874 6.67678 15.7803 6.96967C16.0732 7.26256 16.0732 7.73744 15.7803 8.03033L10.5303 13.2803C10.2374 13.5732 9.76256 13.5732 9.46967 13.2803L4.21967 8.03033Z"/>
                </ToggleButton>
            </Grid>
            <Popup x:Name="CleanOptionsPopup"
                   StaysOpen="False"
                   PlacementTarget="{Binding ElementName=CleanOptionsToggle}"
                   IsOpen="{Binding IsChecked, ElementName=CleanOptionsToggle}"
                   AllowsTransparency="True"
                   VerticalOffset="4"
                   MaxHeight="220">
                <Border Style="{StaticResource PopupSurface}" MinWidth="160">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="200">
                        <StackPanel>
                            <Border Style="{StaticResource HoverRow}">
                                <CheckBox Content="{x:Static p:Strings.Clean_All}"
                                          IsChecked="{Binding AllCleanOptionsChecked, Mode=TwoWay}"
                                          Padding="4,0"
                                          Margin="8,4"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding CleanOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource HoverRow}">
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Padding="4,0"
                                                      Margin="8,4"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="8,2"/>
                            <Border Style="{StaticResource HoverRow}">
                                <CheckBox Content="{x:Static p:Strings.Clean_KeepEndPunct}"
                                          IsChecked="{Binding KeepPunctuationAtParagraphEnd, Mode=TwoWay}"
                                          Padding="4,0"
                                          Margin="8,4"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- ─────────────────────────────────────────────────
                 GENRE SELECTOR
            ───────────────────────────────────────────────── -->
            <TextBlock Text="{x:Static p:Strings.Section_Genre}"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Genres}"
                      SelectedItem="{Binding SelectedGenre, Mode=TwoWay}"
                      Height="28"
                      Margin="0,0,0,12">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- ─────────────────────────────────────────────────
                 SECTION LABEL: IGNORE STYLES
            ───────────────────────────────────────────────── -->

            <TextBlock Text="{x:Static p:Strings.Section_IgnoreStyles}"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,0,0,8"/>

            <!-- Dropdown with checkboxes -->
            <ToggleButton x:Name="IgnoreStylesToggle"
                          Style="{StaticResource CheckedToggle}"
                          Content="{x:Static p:Strings.ChooseStyles}"
                          Height="28"
                          Padding="8,0"
                          FontSize="12"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,0,0"/>
            <Popup x:Name="IgnoreStylesPopup"
                   StaysOpen="False"
                   PlacementTarget="{Binding ElementName=IgnoreStylesToggle}"
                   IsOpen="{Binding IsChecked, ElementName=IgnoreStylesToggle}"
                   AllowsTransparency="True"
                   VerticalOffset="4"
                   MaxHeight="220">
                <Border Style="{StaticResource PopupSurface}"
                        MinWidth="{Binding ActualWidth, ElementName=IgnoreStylesToggle}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="200">
                        <ItemsControl ItemsSource="{Binding Styles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HoverRow}">
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsIgnored, Mode=TwoWay}"
                                                  Padding="4,0"
                                                  Margin="8,4"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- ─────────────────────────────────────────────────
                 NIKUD SUGGESTIONS — alternatives for the selected word
            ───────────────────────────────────────────────── -->
            <TextBlock Text="{x:Static p:Strings.Section_Suggestions}"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,12,0,4"/>
            <!-- Pane is RightToLeft: column 0 renders rightmost (next on the right). -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding NextWordCommand}">
                    <TextBlock Text="{x:Static p:Strings.NextWord}" VerticalAlignment="Center"/>
                </Button>
                <Button Grid.Column="1"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding ShowSuggestionsCommand}"
                        Margin="6,0,6,0"
                        Padding="14,0"
                        ToolTip="{x:Static p:Strings.Tip_Show}">
                    <TextBlock Text="{x:Static p:Strings.Show}" VerticalAlignment="Center"/>
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding PreviousWordCommand}">
                    <TextBlock Text="{x:Static p:Strings.PrevWord}" VerticalAlignment="Center"/>
                </Button>
            </Grid>
            <TextBlock Text="{Binding SuggestionsHint}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecBrush}"
                       Margin="0,0,0,6"/>

            <StackPanel>
                <TextBlock Text="{Binding SuggestionsStatus}"
                           Visibility="{Binding HasSuggestionsStatus, Converter={StaticResource BoolToVis}}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecBrush}"
                           Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding WordOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel FlowDirection="RightToLeft"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.ApplyWordOptionCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    FontFamily="David, Times New Roman"
                                    FontSize="18"
                                    FlowDirection="RightToLeft"
                                    Padding="10,2"
                                    Margin="0,0,6,6"
                                    Cursor="Hand"
                                    ToolTip="{x:Static p:Strings.Tip_ApplyOption}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ─────────────────────────────────────────────────
                 STATUS / BUSY BLOCK — at bottom, hidden while idle
                 Label on top, status area below.
                 When inactive: dimmed with prompt text.
                 When active: full opacity with status/busy message.
            ───────────────────────────────────────────────── -->
            <!-- Hidden while idle; shown only during activity or on error. -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{x:Static p:Strings.Section_Status}"
                           Style="{StaticResource SectionLabel}"
                           Margin="0,12,0,4"/>

                <Border CornerRadius="4" BorderThickness="1" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"  Value="{StaticResource BgSecBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="Opacity"     Value="0.5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Background"  Value="#18DC3545"/>
                                    <Setter Property="BorderBrush" Value="#DC3545"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top row: status text + X button -->
                        <Grid Grid.Row="0" Margin="8,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status / busy text or prompt -->
                            <TextBlock Grid.Column="0"
                                       FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value=""/>
                                        <Setter Property="Foreground" Value="{Binding Foreground,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource OpacityConverter}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Text" Value="{x:Static p:Strings.Busy}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Text" Value="{Binding StatusMessage}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Foreground" Value="#DC3545"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- X button: cancel while busy, clear status when done -->
                            <Button Grid.Column="1"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="6,0" Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Command"  Value="{Binding ClearStatusCommand}"/>
                                        <Setter Property="ToolTip"  Value="{x:Static p:Strings.Close}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Command" Value="{Binding CancelCommand}"/>
                                                <Setter Property="ToolTip" Value="{x:Static p:Strings.Tip_Cancel}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Bottom row: indeterminate progress bar (busy only) -->
                        <ProgressBar Grid.Row="1"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                     IsIndeterminate="True"
                                     Height="2"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"/>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kk="http://schemas.kleikodesh.org/wpf"
                    xmlns:local="clr-namespace:Nakdan.UI">
    <!--
        Nakdan theme dictionary.

        The brushes, buttons, checkbox, combo box and scrollbars all come from
        the shared WpfLib palette. What stays here is only what this pane owns.

        NOTE: Pack URI paths must be all-lowercase (WPF BAML compiler lowercases them).
    -->
    <ResourceDictionary.MergedDictionaries>
        <!-- Shared: WPF does not cache by URI, so a plain merge re-parses the
                         whole palette every time this pane opens. ~20ms, on the UI
                         thread, while the user is waiting for it. -->
                    <kk:SharedResourceDictionary Source="/WpfLib;component/themes/officepalette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ── OpacityConverter — for section labels ────────────────── -->
    <local:OpacityConverter x:Key="OpacityConverter"/>

    <!-- ── SectionLabel — reusable style for all section title TextBlocks ── -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="11"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Foreground"   Value="{Binding Foreground,
                    RelativeSource={RelativeSource AncestorType=UserControl},
                    Converter={StaticResource OpacityConverter}}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

</ResourceDictionary>

<Window SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" x:Class="NakdanTaskPaneDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nakdan="clr-namespace:NakdanTaskPane.UI;assembly=NakdanTaskPane"
        xmlns:local="clr-namespace:NakdanTaskPaneDemo"
        mc:Ignorable="d"
        Title="MainWindow">
    <!-- Content = a Word task pane at width 600 px: 400 x 452 DIPs, measured live in Word at 150%. -->
    <Grid Width="400" Height="452" >
        <nakdan:NakdanView/>
    </Grid>
</Window>

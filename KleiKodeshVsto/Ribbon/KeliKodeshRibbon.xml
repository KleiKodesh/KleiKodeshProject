<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
	<ribbon>
		<tabs>
			<tab idMso="TabHome">
				<group id="Klei_Kodesh3"
					   label="כלי קודש"
					   insertAfterMso="GroupEditing"
					   screentip="כלי קודש לוורד"
					   supertip="ארגז כלים לעורך התורני">

					<splitButton id="mySplitButton" size="large">

						<button id="KleiKodesh_Main"
								label="כלי קודש"
								getImage="getImage"
								onAction="button_Click"/>

						<menu itemSize="large">

							<button id="KitveiHakodesh"
									label="כתבי הקודש"
									screentip="כתבי הקודש"
									supertip="תוסף לוורד עבור מאגר הספרים - זית"
									getImage="getImage"
									onAction="button_Click"
									getVisible="getVisible"/>

							<button id="Kiwix"
									label="ספריית קיוויקס"
									screentip="ספריית קיוויקס"
									supertip="גישה לספרים ואנציקלופדיות במצב לא מקוון דרך קיוויקס"
									getImage="getImage"
									onAction="button_Click"
									getVisible="getVisible"/>

							<!--
<button id="HebrewBooks"
        label="היברו-בוקס"
        screentip="היברו-בוקס"
        supertip="גישה נוחה לספריית היברו-בוקס (דרוש חיבור לאינטרנט)"
        getImage="getImage"
        onAction="button_Click"
        getVisible="getVisible"/>
-->


							<button id="WebSites"
									label="דרך האתרים"
									screentip="דרך האתרים"
									supertip="פתיחת אתרים ייעודיים לעורך התורני - בתוך וורד"
									getImage="getImage"
									onAction="button_Click"
									getVisible="getVisible"/>

							<button id="DocDesign"
									label="עיצוב תורני"
									screentip="עיצוב תורני"
									supertip="כלים לעיצוב ספרי קודש"
									getImage="getImage"
									onAction="button_Click"
									getVisible="getVisible"/>

							<button id="Nakdan"
								label="נקדן דיקטה"
								screentip="נקדן דיקטה"
								supertip="נקדן דיקטה עם אפשרויות משודרגות (דרוש חיבור לאינטרנט)"
								getImage="getImage"
								onAction="button_Click"
								getVisible="getVisible"/>
							
							<button id="RegexFind"
									label="חיפוש רגקס"
									screentip="חיפוש רגקס"
									supertip="חיפוש רגקס בוורד עם אפשרויות עיצוב קלות לשימוש"
									getImage="getImage"
									onAction="button_Click"
									getVisible="getVisible"/>

							<button id="DuplicatePane"
								label="שכפל חלונית צד"
								screentip="שכפל חלונית צד"
								supertip="מאפשר פתיחה של חלונית צד נוספת המשכפלת את חלונית הצד הנוכחית"
								getImage="getImage"
								onAction="button_Click"/>

							<!--<button id="OpenChildDoc"
							label="פתח מסמך בחלונית משנה"
							screentip="מסמך בחלונית משנה"
							supertip="מוצג תמיד מעל המסמך הנוכחי וממוזער יחד איתו"
							getImage="getImage"
							onAction="button_Click"/>-->

							<button id="Settings"
									label="הגדרות"
									getImage="getImage"
									onAction="button_Click"/>

							<button id="About"
									label="אודות"
									getImage="getImage"
									onAction="button_Click"/>

						</menu>
					</splitButton>
				</group>
			</tab>
		</tabs>
	</ribbon>

	<contextMenus>
		<contextMenu idMso="ContextMenuText">
			<button id="SearchFtsFromSelection"
					label="העתק לחיפוש בכתבי הקודש"
					getImage="getKitveiHakodeshIcon"
					onAction="contextMenu_Click"
					insertBeforeMso="Cut"/>
			<button id="SearchCatalogFromSelection"
					label="חיפוש ספר בכתבי הקודש"
					getImage="getKitveiHakodeshIcon"
					onAction="contextMenu_Click"
					insertBeforeMso="Cut"/>
			<button id="OpenLinkInKitveiHakodesh"
					label="פתח קישור בכתבי הקודש"
					getImage="getKitveiHakodeshIcon"
					onAction="openLink_Click"
					getVisible="getContextVisible"
					insertBeforeMso="Cut"/>
			<menuSeparator id="KleiKodeshContextSeparator"
						   insertBeforeMso="Cut"/>
		</contextMenu>

		<!-- Right-clicking ON a hyperlink swaps in the hyperlink-specific menu
		     (ContextMenuHyperlink) — NOT ContextMenuText. Only the open-link item
		     belongs here (the two search items require selected text). Anchored before
		     "Cut" — the first built-in control on this menu — so it sits at the very top
		     (anchoring before HyperlinkEdit put it below Cut/Copy/Paste). -->
		<contextMenu idMso="ContextMenuHyperlink">
			<button id="OpenLinkInKitveiHakodeshHl"
					label="פתח קישור בכתבי הקודש"
					getImage="getKitveiHakodeshIcon"
					onAction="openLink_Click"
					getVisible="getContextVisible"
					insertBeforeMso="Cut"/>
			<menuSeparator id="KleiKodeshContextSeparatorHl"
						   insertBeforeMso="Cut"/>
		</contextMenu>

		<!-- Numbered- and bulleted-list paragraphs use their OWN context menus
		     (ContextMenuListsNumbering / ContextMenuListsBullets), NOT
		     ContextMenuText, so right-clicking a list item never shows the items
		     above. Office has no "all menus" hook — the search items must be
		     repeated per menu, with globally-unique ids (the -Num / -Bul suffixes).
		     contextMenu_Click / getContextVisible key off "Catalog" in the id, so
		     the suffix does not change their behaviour. -->
		<contextMenu idMso="ContextMenuListsNumbering">
			<button id="SearchFtsFromSelectionNum"
					label="העתק לחיפוש בכתבי הקודש"
					getImage="getKitveiHakodeshIcon"
					onAction="contextMenu_Click"
					insertBeforeMso="Cut"/>
			<button id="SearchCatalogFromSelectionNum"
					label="חיפוש ספר בכתבי הקודש"
					getImage="getKitveiHakodeshIcon"
					onAction="contextMenu_Click"
					insertBeforeMso="Cut"/>
			<button id="OpenLinkInKitveiHakodeshNum"
					label="פתח קישור בכתבי הקודש"
					getImage="getKitveiHakodeshIcon"
					onAction="openLink_Click"
					getVisible="getContextVisible"
					insertBeforeMso="Cut"/>
			<menuSeparator id="KleiKodeshContextSeparatorNum"
						   insertBeforeMso="Cut"/>
		</contextMenu>

		<contextMenu idMso="ContextMenuListsBullets">
			<button id="SearchFtsFromSelectionBul"
					label="העתק לחיפוש בכתבי הקודש"
					getImage="getKitveiHakodeshIcon"
					onAction="contextMenu_Click"
					insertBeforeMso="Cut"/>
			<button id="SearchCatalogFromSelectionBul"
					label="חיפוש ספר בכתבי הקודש"
					getImage="getKitveiHakodeshIcon"
					onAction="contextMenu_Click"
					insertBeforeMso="Cut"/>
			<button id="OpenLinkInKitveiHakodeshBul"
					label="פתח קישור בכתבי הקודש"
					getImage="getKitveiHakodeshIcon"
					onAction="openLink_Click"
					getVisible="getContextVisible"
					insertBeforeMso="Cut"/>
			<menuSeparator id="KleiKodeshContextSeparatorBul"
						   insertBeforeMso="Cut"/>
		</contextMenu>
	</contextMenus>
</customUI>

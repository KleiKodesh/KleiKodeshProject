<UserControl x:Class="KleiKodesh.Ribbon.RibbonSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kk="http://schemas.kleikodesh.org/wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI"
             FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The whole palette, not just the scrollbars. This view used to
                     merge scrollbarstyles alone and then hand-roll a button, a
                     checkbox, a radio button and a separator that the palette
                     already defines. -->
                <kk:SharedResourceDictionary Source="/WpfLib;component/themes/officepalette.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style TargetType="CheckBox" BasedOn="{StaticResource OfficeCheckBox}">
            <Setter Property="Margin"  Value="0,0,0,6"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style TargetType="RadioButton" BasedOn="{StaticResource OfficeRadioButton}">
            <Setter Property="Margin"  Value="0,0,0,6"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style TargetType="Separator" BasedOn="{StaticResource OfficeSeparator}">
            <Setter Property="Margin" Value="0,8"/>
        </Style>

        <!-- Scrollbars come from WpfLib/Themes/ScrollBarStyles.xaml, merged above. -->

        <!-- ActionButton is this, with the standard 12,5 padding rather than
             14,5 and the palette's hover instead of a full colour inversion. -->
        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <StackPanel Margin="12" Background="Transparent">

            <Border Style="{StaticResource Card}">
                <Expander>
                    <Expander.Header>
                        <TextBlock x:Name="VisibleHeader" Style="{StaticResource GroupHeader}"/>
                    </Expander.Header>
                    <StackPanel x:Name="VisibleSettingsPanel">
                        <Separator/>
                        <!--
                        IMPORTANT — control names are registry settings keys.
                        InitializeControls() iterates VisibleSettingsPanel.Children and passes cb.Name
                        directly to SettingsManager as the key (e.g. "KitveiHakodesh_Visible").
                        Do NOT rename these — the name IS the key.
                        Format: {ComponentId}_Visible
                    -->
                        <CheckBox x:Name="KitveiHakodesh_Visible"   />
                        <CheckBox x:Name="Kiwix_Visible"     />
                        <CheckBox x:Name="WebSites_Visible"  />
                        <CheckBox x:Name="KleiKodesh_Visible"/>
                        <CheckBox x:Name="Nakdan_Visible"/>
                        <CheckBox x:Name="RegexFind_Visible"  Margin="0"/>
                    </StackPanel>
                </Expander>
            </Border>

            <Border Style="{StaticResource Card}">
                <Expander>
                    <Expander.Header>
                        <TextBlock x:Name="OptionsHeader" Style="{StaticResource GroupHeader}"/>
                    </Expander.Header>
                    <StackPanel x:Name="OptionsSettingsPanel">
                        <Separator/>
                        <!--
                        IMPORTANT — control names encode the settings value.
                        InitializeControls() iterates OptionsSettingsPanel.Children and derives the
                        DefaultButton value by stripping "_Option" from rb.Name (e.g. "KitveiHakodesh_Option" → "KitveiHakodesh").
                        Do NOT rename these — the name IS the value.
                        Format: {ComponentId}_Option  (ComponentId must match the one used in _Visible above)
                        Settings_Option is the fallback and is not tied to a visibility checkbox.
                    -->
                        <RadioButton x:Name="KitveiHakodesh_Option"           IsEnabled="{Binding IsChecked, ElementName=KitveiHakodesh_Visible}"/>
                        <RadioButton x:Name="Kiwix_Option"          IsEnabled="{Binding IsChecked, ElementName=Kiwix_Visible}"/>
                        <RadioButton x:Name="WebSites_Option"    IsEnabled="{Binding IsChecked, ElementName=WebSites_Visible}"/>
                        <RadioButton x:Name="KleiKodesh_Option" IsEnabled="{Binding IsChecked, ElementName=KleiKodesh_Visible}"/>
                        <RadioButton x:Name="Nakdan_Option" IsEnabled="{Binding IsChecked, ElementName=KleiKodesh_Visible}"/>
                        <RadioButton x:Name="RegexFind_Option"   IsEnabled="{Binding IsChecked, ElementName=RegexFind_Visible}"/>
                        <RadioButton x:Name="Settings_Option"        Margin="0"/>
                    </StackPanel>
                </Expander>
            </Border>

            <CheckBox x:Name="ChkTurnOffUpdates"
                      Margin="0,0,0,8"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="LanguageHeader" Style="{StaticResource GroupHeader}"/>
                    <Separator/>
                    <!-- General/UiLanguage, shared with the installer (Helpers/AddinUiLanguage.cs). -->
                    <RadioButton x:Name="HebrewLanguageRadio"  GroupName="UiLanguage" Content="&#x05E2;&#x05D1;&#x05E8;&#x05D9;&#x05EA;"/>
                    <RadioButton x:Name="EnglishLanguageRadio" GroupName="UiLanguage" Content="English"/>
                    <TextBlock x:Name="LanguageHint" TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Optional VBA macros template (Helpers/VbaMacrosTemplate.cs) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="MacrosHeader" Style="{StaticResource GroupHeader}"/>
                    <Separator/>
                    <RadioButton x:Name="MacrosNoneRadio"    GroupName="VbaMacros"/>
                    <RadioButton x:Name="MacrosHebrewRadio"  GroupName="VbaMacros"/>
                    <RadioButton x:Name="MacrosEnglishRadio" GroupName="VbaMacros"/>
                    <TextBlock x:Name="MacrosHint" TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                </StackPanel>
            </Border>

            <Button x:Name="BtnReset"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>

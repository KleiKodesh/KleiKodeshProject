<UserControl x:Class="KleiKodesh.Ribbon.RibbonSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kk="http://schemas.kleikodesh.org/wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI"
             FontSize="13">
    <!--
        Looks like the new installer (Build/installer-rs): flat sections with small semibold headings, thin dividers, plenty of space, Office's own
        controls. Colours come from the pane's Background/Foreground (OfficeThemeWatcher), so
        it follows Word's light and dark themes.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The whole palette, not just the scrollbars. This view used to
                     merge scrollbarstyles alone and then hand-roll a button, a
                     checkbox, a radio button and a separator that the palette
                     already defines. -->
                <kk:SharedResourceDictionary Source="/WpfLib;component/themes/officepalette.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="CheckBox" BasedOn="{StaticResource OfficeCheckBox}">
                <Setter Property="Margin"  Value="0,0,0,8"/>
                <Setter Property="Padding" Value="8,0"/>
            </Style>

            <Style TargetType="RadioButton" BasedOn="{StaticResource OfficeRadioButton}">
                <Setter Property="Margin"  Value="0,0,0,8"/>
                <Setter Property="Padding" Value="8,0"/>
            </Style>

            <!-- Muted secondary text: the hints under a section. -->
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="12"/>
                <Setter Property="Opacity"      Value="0.7"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Section heading: small and semibold. -->
            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin"     Value="0,0,0,10"/>
            </Style>

            <!-- Thin divider between sections, in the pane's own text colour, faint. -->
            <Style x:Key="SectionDivider" TargetType="Border">
                <Setter Property="Height"     Value="1"/>
                <Setter Property="Margin"     Value="0,14,0,16"/>
                <Setter Property="Opacity"    Value="0.15"/>
                <Setter Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Style>

            <!-- The reset button sits at the start, sized to its text. -->
            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="MinWidth"            Value="120"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <StackPanel Margin="20,16,20,20" Background="Transparent">

            <!-- No title or intro: the task pane's caption names it, the ribbon button's tooltip explains it. -->

            <TextBlock x:Name="VisibleHeader" Style="{StaticResource SectionHeading}"/>
            <StackPanel x:Name="VisibleSettingsPanel">
                <!--
                IMPORTANT — control names are registry settings keys.
                InitializeControls() iterates VisibleSettingsPanel.Children and passes cb.Name
                directly to SettingsManager as the key (e.g. "KitveiHakodesh_Visible").
                Do NOT rename these — the name IS the key.
                Format: {ComponentId}_Visible
                -->
                <CheckBox x:Name="KitveiHakodesh_Visible"/>
                <CheckBox x:Name="Kiwix_Visible"/>
                <CheckBox x:Name="WebSites_Visible"/>
                <CheckBox x:Name="KleiKodesh_Visible"/>
                <CheckBox x:Name="Nakdan_Visible"/>
                <CheckBox x:Name="RegexFind_Visible" Margin="0"/>
            </StackPanel>
            <Border Style="{StaticResource SectionDivider}"/>

            <TextBlock x:Name="OptionsHeader" Style="{StaticResource SectionHeading}"/>
            <StackPanel x:Name="OptionsSettingsPanel">
                <!--
                IMPORTANT — control names encode the settings value.
                InitializeControls() iterates OptionsSettingsPanel.Children and derives the
                DefaultButton value by stripping "_Option" from rb.Name (e.g. "KitveiHakodesh_Option" → "KitveiHakodesh").
                Do NOT rename these — the name IS the value.
                Format: {ComponentId}_Option  (ComponentId must match the one used in _Visible above)
                Settings_Option is the fallback and is not tied to a visibility checkbox.
                -->
                <RadioButton x:Name="KitveiHakodesh_Option" IsEnabled="{Binding IsChecked, ElementName=KitveiHakodesh_Visible}"/>
                <RadioButton x:Name="Kiwix_Option"          IsEnabled="{Binding IsChecked, ElementName=Kiwix_Visible}"/>
                <RadioButton x:Name="WebSites_Option"       IsEnabled="{Binding IsChecked, ElementName=WebSites_Visible}"/>
                <RadioButton x:Name="KleiKodesh_Option"     IsEnabled="{Binding IsChecked, ElementName=KleiKodesh_Visible}"/>
                <RadioButton x:Name="Nakdan_Option"         IsEnabled="{Binding IsChecked, ElementName=KleiKodesh_Visible}"/>
                <RadioButton x:Name="RegexFind_Option"      IsEnabled="{Binding IsChecked, ElementName=RegexFind_Visible}"/>
                <RadioButton x:Name="Settings_Option"       Margin="0"/>
            </StackPanel>
            <Border Style="{StaticResource SectionDivider}"/>

            <!-- General/UiLanguage, shared with the installer (Helpers/AddinUiLanguage.cs). -->
            <TextBlock x:Name="LanguageHeader" Style="{StaticResource SectionHeading}"/>
            <RadioButton x:Name="HebrewLanguageRadio"  GroupName="UiLanguage" Content="&#x05E2;&#x05D1;&#x05E8;&#x05D9;&#x05EA;"/>
            <RadioButton x:Name="EnglishLanguageRadio" GroupName="UiLanguage" Content="English"/>
            <TextBlock x:Name="LanguageHint" Style="{StaticResource Muted}"/>
            <Border Style="{StaticResource SectionDivider}"/>

            <!-- Optional VBA macros template (Helpers/VbaMacrosTemplate.cs) -->
            <TextBlock x:Name="MacrosHeader" Style="{StaticResource SectionHeading}"/>
            <RadioButton x:Name="MacrosNoneRadio"    GroupName="VbaMacros"/>
            <RadioButton x:Name="MacrosInstallRadio" GroupName="VbaMacros"/>
            <TextBlock x:Name="MacrosHint" Style="{StaticResource Muted}"/>
            <Border Style="{StaticResource SectionDivider}"/>

            <!-- Updates: status, check now, install, and the shared turn-off switch. -->
            <TextBlock x:Name="UpdatesHeader" Style="{StaticResource SectionHeading}"/>
            <TextBlock x:Name="UpdateInstalledText" Style="{StaticResource Muted}"/>
            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Muted}" Margin="0,2,0,10"/>
            <Button x:Name="BtnInstallUpdate" Margin="0,0,0,8" Visibility="Collapsed"/>
            <Button x:Name="BtnCheckUpdates" Margin="0,0,0,12"/>
            <CheckBox x:Name="ChkTurnOffUpdates" Margin="0,0,0,16"/>
            <Border Style="{StaticResource SectionDivider}"/>

            <Button x:Name="BtnReset"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Root theme dictionary — merges the shared WpfLib palette, then whatever
        is genuinely specific to this pane.
        NOTE: Pack URI paths must be all-lowercase (WPF BAML compiler lowercases them).
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WpfLib;component/themes/officepalette.xaml"/>
        <ResourceDictionary Source="/WebSitesLib;component/ui/themes/icons.xaml"/>
        <ResourceDictionary Source="/WebSitesLib;component/ui/themes/miscstyles.xaml"/>
        <ResourceDictionary Source="/WebSitesLib;component/ui/themes/addressbarstyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- This pane's toggles show their checked state. -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource AccentToggle}"/>
</ResourceDictionary>

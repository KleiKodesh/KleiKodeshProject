<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:kk="http://schemas.kleikodesh.org/wpf"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <kk:SharedResourceDictionary Source="/WpfLib;component/themes/themedcontrol.xaml"/>
        <kk:SharedResourceDictionary Source="/WpfLib;component/themes/brushes.xaml"/>
        <kk:SharedResourceDictionary Source="/WpfLib;component/themes/liststyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!-- Scrollbars come from WpfLib/Themes/ScrollBarStyles.xaml (via OfficePalette). -->

    <!-- ── ListBox — transparent, no border ─────────────────────── -->
    <!-- The palette's list box. It also carries the dark-theme foreground,
         virtualization, and OfficeListBoxItem containers, none of which the
         restated copy this replaces had. The two tab-strip lists override the
         container with TabItemStyle at the call site. -->
    <Style TargetType="ListBox" BasedOn="{StaticResource OfficeListBox}"/>

    <!-- ── Tab strip list item — no chrome ──────────────────────── -->
    <Style x:Key="TabItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ThemedControl}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsSelected"       Value="{Binding IsSelected}"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Padding"          Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Dialog list item ──────────────────────────────────────── -->
    <!--
        The palette's list row, at this dialog's padding.

        This used to be a full template: transparent border, hover tint,
        selected tint. That is OfficeListBoxItem, reached separately - and the
        standard is the better of the two, because it also handles selected AND
        hovered together, and dims when disabled, neither of which this had.
    -->
    <Style x:Key="DialogListItem" TargetType="ListBoxItem" BasedOn="{StaticResource OfficeListBoxItem}">
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- CheckBox comes from WpfLib/Themes/CheckBoxStyles.xaml (via OfficePalette). -->

</ResourceDictionary>

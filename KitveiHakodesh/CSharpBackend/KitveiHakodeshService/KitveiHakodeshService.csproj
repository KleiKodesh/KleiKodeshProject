<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>

    <!-- Idle-RAM tuning. The service spends most of its life idle between bursts of
         search/index work; a heavy search grows the GC heap to hundreds of MB. These
         make the runtime give that memory back to the OS instead of retaining it:
           - Workstation, concurrent GC (the default, restated): the server GC keeps a
             per-core heap and is far more memory-hungry — wrong for a mostly-idle helper.
           - RetainVMGarbageCollection=false: decommit freed segments to the OS rather
             than parking them on a standby list for reuse. This is THE switch that lets
             idle RAM fall after the trim's GC, instead of staying committed.
           - GCConserveMemory=9: bias every collection toward a small heap (compacts the
             LOH when fragmented). Higher pause cost, which is irrelevant while idle. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <!-- Required by the LibraryImport source generator (advapi32 SCM P/Invokes). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UserSecretsId>dotnet-KitveiHakodeshService-65893fd5-946c-4ba8-8798-4e827a79ea21</UserSecretsId>
  </PropertyGroup>

  <!-- Catalog databases shipped with the service, copied to output only when newer. -->
  <ItemGroup>
    <Content Include="HebrewBooks\HebrewBooksCatalog.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Dictionary\Dictionary.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 10.0.9 (e_sqlite3), NOT 11.x: FtsLib's segment writer does File.Move on a just-written
         SQLite file; 11.x's SourceGear provider keeps the handle open (pooling) and the move
         fails with a sharing violation. 10.0.9 matches FtsLib and is AOT/AnyCPU-friendly. -->
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <!-- Catalog TOC-path search (Catalog/CatalogTocIndex). 4.8 beta — the only line. -->
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00018" />
  </ItemGroup>

  <!-- Lucene discovers codecs/postings/doc-values formats via reflection (NamedSPILoader +
       Activator.CreateInstance). Root the assembly so ILC keeps that metadata under native
       AOT — without this the published exe throws MissingMethodException on first use
       (verified with an AOT probe, 2026-07-17). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Lucene.Net" />
  </ItemGroup>

  <!-- The custom full-text search engine. FtsLib multi-targets net48;net10.0; the net10.0
       leg is referenced here so the service can run FTS searches in-process. -->
  <ItemGroup>
    <ProjectReference Include="..\Ftslib-Csharp\FtsLib\FtsLib.csproj" />
  </ItemGroup>
</Project>

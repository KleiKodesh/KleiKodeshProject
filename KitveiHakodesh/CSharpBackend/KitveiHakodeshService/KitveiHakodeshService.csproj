<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <!-- IL2104/IL3053 are one-line summaries saying a THIRD-PARTY assembly (Lucene.Net,
         J2N, MessagePack, framework libs) has trim/AOT notes inside it. Nothing to fix
         on our side; the AOT service is tested working. Our own code still warns. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>

    <!-- Idle-RAM tuning. The service spends most of its life idle between bursts of
         search/index work; a heavy search grows the GC heap to hundreds of MB. These
         make the runtime give that memory back to the OS instead of retaining it:
           - Workstation, concurrent GC (the default, restated): the server GC keeps a
             per-core heap and is far more memory-hungry — wrong for a mostly-idle helper.
           - RetainVMGarbageCollection=false: decommit freed segments to the OS rather
             than parking them on a standby list for reuse. This is THE switch that lets
             idle RAM fall after the trim's GC, instead of staying committed.
           - GCConserveMemory=9: bias every collection toward a small heap (compacts the
             LOH when fragmented). Higher pause cost, which is irrelevant while idle. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <!-- Required by the LibraryImport source generator (advapi32 SCM P/Invokes). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UserSecretsId>dotnet-KitveiHakodeshService-65893fd5-946c-4ba8-8798-4e827a79ea21</UserSecretsId>
    <!-- Win32 version-resource fields. AssemblyTitle becomes FileDescription, which is the
         program name Windows shows in the UAC consent dialog; Company fills the publisher
         line for an unsigned exe. Keep these Hebrew — with nothing set the SDK defaults
         them to the assembly name and the prompt reads "KitveiHakodeshService". Matters
         whenever this exe elevates (SCM register/unregister of the indexing service). -->
    <AssemblyTitle>כתבי הקודש (שירות)</AssemblyTitle>
    <Product>כלי קודש</Product>
    <Company>כלי קודש</Company>
    <Description>שירות אינדוקס קבצים — כלי קודש</Description>
    <!-- Embed the UAC manifest. It requests asInvoker, NOT elevation — correct for both the
         dev spawn (inherits the terminal token, stays rebuildable) and the production
         Windows service (gets LocalSystem from the SCM, no manifest elevation needed).
         requireAdministrator here would make CreateProcess fail with ERROR_ELEVATION_REQUIRED
         for any non-elevated parent, which breaks `npm run dev` from a normal terminal.
         Note: elevation is NOT optional for the product — without USN access PathIndex has
         no watcher at all and the index freezes at build time. See Properties\app.manifest. -->
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <!-- Same icon as the app: the service exe shows in Task Manager and the UAC prompt. -->
    <ApplicationIcon>..\KitveiHakodeshDemoApp\KitveiHakodeshLarge.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- GCConserveMemory has no MSBuild property, and PublishAot ignores
       runtimeconfig.template.json, so it is set here. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

  <ItemGroup>
    <!-- 10.0.9 (e_sqlite3), NOT 11.x: FtsLib's segment writer does File.Move on a just-written
         SQLite file; 11.x's SourceGear provider keeps the handle open (pooling) and the move
         fails with a sharing violation. 10.0.9 matches FtsLib and is AOT/AnyCPU-friendly. -->
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Lifts the native SQLite past 2.1.11 (GHSA-2m69-gcr7-jv3q) that Microsoft.Data.Sqlite 10.0.9 pulls in. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <!-- Windows-service lifetime (SCM start/stop) for the installed service; a no-op when the
         exe is spawned as a console process (dev, portable). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.9" />
    <!-- Catalog TOC-path search (Catalog/CatalogTocIndex). 4.8 beta — the only line. -->
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00018" />
  </ItemGroup>

  <!-- The catalog abbreviation table now lives in KitveiHakodesh.Core as
       SeforimDbCatalog/SeforimDbCatalogAbbreviations.cs, HAND-EDITED rather than generated, so
       the csv/json/generator pipeline and the staleness check that guarded it are retired. -->

  <!-- Lucene discovers codecs/postings/doc-values formats via reflection (NamedSPILoader +
       Activator.CreateInstance). Root the assembly so ILC keeps that metadata under native
       AOT — without this the published exe throws MissingMethodException on first use
       (verified with an AOT probe, 2026-07-17). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Lucene.Net" />
  </ItemGroup>

  <!-- The custom full-text search engine. FtsLib multi-targets net48;net10.0; the net10.0
       leg is referenced here so the service can run FTS searches in-process. -->
  <ItemGroup>
    <!-- The shared backend library. Every data/domain operation lives here; the classes in
         this project are thin transport wrappers that call into it. Core multi-targets
         net48;net10.0-windows — the net10.0-windows leg is used here, and it is AOT-clean
         (IsAotCompatible) because this project publishes native AOT. -->
    <ProjectReference Include="..\KitveiHakodesh.Core\KitveiHakodesh.Core.csproj" />
  </ItemGroup>
  <!-- A release must ship the HebrewBooks download fallbacks. hb-mirror.json is kept out of git
       (it holds the R2 keys), so a machine without it would publish a service that silently
       downloads from the official handler only. Publish-only: dev builds are not blocked. -->
  <Target Name="RequireHebrewBooksMirrorConfig" BeforeTargets="PrepareForPublish"
          Condition="!Exists('$(MSBuildThisFileDirectory)..\KitveiHakodesh.Core\HebrewBooks\hb-mirror.json')">
    <Error Text="KitveiHakodesh.Core\HebrewBooks\hb-mirror.json is missing. It holds the HebrewBooks download fallbacks (public mirror + R2 keys) and is not in git - copy it onto this machine before publishing a release, or released downloads will have no fallback when hebrewbooks.org is blocked." />
  </Target>
</Project>

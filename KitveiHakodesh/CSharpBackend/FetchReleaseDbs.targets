<Project>
  <!--
    Downloads the latest released DB this project ships (Dictionary.db or
    expansion-routed.db) before every build, via the ONE shared script
    Build/scripts/fetch-release-dbs.ps1 (-Mode IfStale: network at most every 6 h; offline
    with an existing file = warning only; missing file and no network = build error).

    Import it after setting FetchReleaseDb to "dictionary" or "expansion":
      <PropertyGroup><FetchReleaseDb>dictionary</FetchReleaseDb></PropertyGroup>
      <Import Project="..\FetchReleaseDbs.targets" />

    Skip with -p:SkipReleaseDbFetch=true (build-installer.ps1 passes it after fetching
    with -Mode Always itself).
  -->
  <PropertyGroup>
    <FetchReleaseDbsScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Build\scripts\fetch-release-dbs.ps1'))</FetchReleaseDbsScript>
    <FetchReleaseDbsShell Condition="'$(OS)' == 'Windows_NT'">powershell -NoLogo -NoProfile -ExecutionPolicy Bypass</FetchReleaseDbsShell>
    <FetchReleaseDbsShell Condition="'$(OS)' != 'Windows_NT'">pwsh -NoLogo -NoProfile</FetchReleaseDbsShell>
  </PropertyGroup>

  <Target Name="FetchReleaseDb"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipReleaseDbFetch)' != 'true' And '$(FetchReleaseDb)' != ''">
    <Exec Command="$(FetchReleaseDbsShell) -File &quot;$(FetchReleaseDbsScript)&quot; -Mode IfStale -Only $(FetchReleaseDb)" />
  </Target>
</Project>

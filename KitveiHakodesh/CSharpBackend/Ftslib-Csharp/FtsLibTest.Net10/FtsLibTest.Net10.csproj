<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FtsLibTest</RootNamespace>
    <!-- Must match FtsLib's InternalsVisibleTo("FtsLibTest") so tests can see internals. -->
    <AssemblyName>FtsLibTest</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FtsLib\FtsLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share the net48 test sources (linked). Exclude the entry point (net10 has its own),
         obj/bin, Properties (SDK generates assembly info), and every file that touches
         System.Data.SQLite / SegmentHandle SQLite types directly (net48-only diagnostics). -->
    <Compile Include="..\FtsLibTest\**\*.cs"
             Exclude="..\FtsLibTest\Program.cs;..\FtsLibTest\obj\**\*.cs;..\FtsLibTest\bin\**\*.cs;..\FtsLibTest\Properties\**\*.cs;..\FtsLibTest\DbQuery.cs;..\FtsLibTest\Shared\DiffIds.cs;..\FtsLibTest\SearchIndex\ExpandDiag.cs;..\FtsLibTest\SearchIndex\LookupDiag.cs;..\FtsLibTest\SearchIndex\PrefixLenDiag.cs;..\FtsLibTest\SearchIndex\VerifyPrefixScan.cs;..\FtsLibTest\SearchIndex\WildcardDiag.cs;..\FtsLibTest\SearchIndex\FstSizeDiag.cs;..\FtsLibTest\SearchIndex\FileLoadDiag.cs">
      <Link>shared\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10-ONLY. The .NET Framework build now lives in the separate FtsLib.Net48
         project (reverted to System.Data.SQLite) used by the hosted KitveiHakodeshLib /
         DemoApp. THIS project is the forward, net10-optimized FTS engine used by
         KitveiHakodeshService — free to use hardware intrinsics net48 can't. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FtsLib</RootNamespace>
    <AssemblyName>FtsLib</AssemblyName>
    <!-- Keep the hand-written Properties\AssemblyInfo.cs (holds InternalsVisibleTo("FtsLibTest")). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <!-- CA1416: Microsoft.VisualBasic.Interaction.GetSetting is Windows-only; fine (runs on Windows). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- For SIMD hot-path optimizations (Vector256/512 loads, hardware popcount). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to 10.0.9 to match KitveiHakodeshService (avoids a diamond version conflict). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
  </ItemGroup>

  <!-- The related-forms expansion artifact (research/word-association, FINDINGS
       26/27). ONE canonical copy shared by every FtsLib flavour lives in
       FtsLib-Csharp/SearchExpansion/ - updating that file updates all outputs.
       Copied next to consumers as SearchExpansion/expansion-routed.db and read
       at runtime relative to the binary (see SearchExpansionService /
       SearchExpansion). -->
  <ItemGroup>
    <Content Include="..\SearchExpansion\expansion-routed.db">
      <Link>SearchExpansion\expansion-routed.db</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

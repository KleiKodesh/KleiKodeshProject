<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FtsLibTest</RootNamespace>
    <!-- Must match FtsLib's InternalsVisibleTo("FtsLibTest") so tests can see internals. -->
    <AssemblyName>FtsLibTest</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Lifts the native SQLite past 2.1.11 (GHSA-2m69-gcr7-jv3q) that Microsoft.Data.Sqlite 10.0.9 pulls in. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <!-- For Corpus/SeforimLineContent.cs: schema 6 of the seforim database stores line content
         zstd-compressed with a dictionary shipped inside the database. This belongs HERE, not in
         the engine — the test suite is what reads that corpus now. Pure-C# port, nothing native
         to package. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FtsLib\FtsLib.csproj" />
  </ItemGroup>

</Project>

DB_PATH=C:\Users\Admin\AppData\Roaming\io.github.kdroidfilter.seforimapp\databases\seforim.db
# FTS: by default the service builds its own index in the background, in a "FtsIndex"
# folder next to the service binary (bin\Debug\net10.0\FtsIndex) from DB_PATH — so
# deleting the service deletes its index too. To reuse an existing index instead of
# building, set FTS_INDEX_PATH to that directory, e.g.:
# FTS_INDEX_PATH=C:\Users\Public\Documents\KleiKodeshProject\KitveiHakodesh\CSharpBackend\Ftslib-Csharp\FtsLibTest\bin\Release\index_full

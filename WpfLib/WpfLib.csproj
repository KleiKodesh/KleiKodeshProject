<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WpfLib targets net48 for the Office add-in, and net10.0-windows so a WPF
    app on modern .NET can use the palette without being dragged back to
    Framework.

    SDK-style, so the file globs its own sources instead of listing thirty
    Compile and sixteen Page items by hand. GenerateAssemblyInfo is off
    because Properties/AssemblyInfo.cs carries the XmlnsDefinition attributes.

    ProjectGuid is kept: the old-style consumers name it in their
    ProjectReference and Visual Studio complains if it moves.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>WpfLib</RootNamespace>
    <AssemblyName>WpfLib</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProjectGuid>{494B02C1-54F2-4244-9A90-23C9984970E7}</ProjectGuid>
    <!-- Helpers/FontsProvider.cs calls DirectWrite through unmanaged pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- net48 needs System.Text.Json from NuGet; it is in the box on net10. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Configuration" />
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
  </ItemGroup>

</Project>

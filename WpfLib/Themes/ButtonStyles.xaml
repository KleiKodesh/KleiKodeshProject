<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:themes="clr-namespace:WpfLib.Themes"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Flat button and toggle styles — adaptive, work on any Office theme.
        All values inlined — no StaticResource inside ControlTemplates (VSTO rule).

        CORNER RADIUS IS 4, like every other control and surface in the palette.
        These buttons used to be 2, which put a button and a toggle side by side
        in the same toolbar with different corners, and made a dialog's OK button
        tighter than the field above it. 2 is reserved for small marks and rows:
        the checkbox tick box, a list row, a progress bar.

        Foreground is set with a PriorityBinding, not left to inherit and not
        bound to a single ancestor. See the note on IconButton below; getting
        this wrong is what made button labels dark on a dark theme.

        IconButton    : flat icon button — transparent, hover/pressed overlays,
                        disabled at 35% opacity. Also the implicit Button style.
        IconToggle    : flat icon toggle — hover/pressed only, NO checked highlight.
        AccentToggle  : flat icon toggle that fills with accent while checked, and
                        keeps the accent under the cursor instead of losing it.
        CheckedToggle : bordered toggle with an accent checked state.
        ActionButton  : bordered action button for dialogs (OK, Apply, etc.).
        IconPath      : Path inside an icon button — inherits the pane foreground.

        Sizing is deliberately NOT set here beyond Padding. A library that needs a
        fixed metric derives from these with BasedOn and adds Width/Height/Margin,
        so this file stays about how a control LOOKS, not how big it is.

        There is intentionally no implicit ToggleButton style — the two toggle
        behaviours are both legitimate, so each library aliases the one it wants:
            <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}"/>
    -->

    <!-- ── IconButton — flat icon button ─────────────────────────── -->
    <Style x:Key="IconButton" TargetType="Button">
        <!--
            Foreground has to be stated, and it has to work in both hosts.

            Leaving it unset does NOT inherit: WPF's theme style for Button
            sets Foreground, and theme-style setters outrank inheritance, so
            an unset Foreground lands on Aero's dark default and button text
            comes out near-black on a dark Office theme.

            Binding it to an ancestor UserControl works in a task pane and
            fails in a plain Window. PriorityBinding takes whichever resolves:
            the pane's UserControl if there is one, otherwise the Window.
        -->
        <Setter Property="Foreground">
            <Setter.Value>
                <PriorityBinding>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </PriorityBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="6"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0A808080"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14808080"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── IconToggle — flat, no checked highlight ───────────────── -->
    <Style x:Key="IconToggle" TargetType="ToggleButton">
        <!--
            Foreground has to be stated, and it has to work in both hosts.

            Leaving it unset does NOT inherit: WPF's theme style for Button
            sets Foreground, and theme-style setters outrank inheritance, so
            an unset Foreground lands on Aero's dark default and button text
            comes out near-black on a dark Office theme.

            Binding it to an ancestor UserControl works in a task pane and
            fails in a plain Window. PriorityBinding takes whichever resolves:
            the pane's UserControl if there is one, otherwise the Window.
        -->
        <Setter Property="Foreground">
            <Setter.Value>
                <PriorityBinding>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </PriorityBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="6"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0A808080"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14808080"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── AccentToggle — accent fill while checked ──────────────────
         A plain IsChecked trigger loses to IsMouseOver, so hovering a checked
         toggle would drop the accent and read as "off". These MultiTriggers
         keep it, and brighten it under the cursor instead.
    -->
    <Style x:Key="AccentToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- unchecked hover -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked"   Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#0A808080"/>
                        </MultiTrigger>
                        <!-- checked — keep the accent, even under the cursor -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked"   Value="True"/>
                                <Condition Property="IsMouseOver" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#3300B4FF"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked"   Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#4400B4FF"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14808080"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── CheckedToggle — bordered toggle with accent checked state ─ -->
    <Style x:Key="CheckedToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#50808080"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="#3300B4FF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="#0A808080"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#80808080"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="#14808080"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ActionButton — bordered, for dialogs (OK, Apply, etc.) ── -->
    <Style x:Key="ActionButton" TargetType="Button">
        <!--
            Foreground has to be stated, and it has to work in both hosts.

            Leaving it unset does NOT inherit: WPF's theme style for Button
            sets Foreground, and theme-style setters outrank inheritance, so
            an unset Foreground lands on Aero's dark default and button text
            comes out near-black on a dark Office theme.

            Binding it to an ancestor UserControl works in a task pane and
            fails in a plain Window. PriorityBinding takes whichever resolves:
            the pane's UserControl if there is one, otherwise the Window.
        -->
        <Setter Property="Foreground">
            <Setter.Value>
                <PriorityBinding>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </PriorityBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding"          Value="12,5"/>
        <Setter Property="FontSize"         Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="FontFamily"       Value="{StaticResource UiFontFamily}"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="#50808080"
                            Background="#0F808080"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="#0A808080"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#80808080"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="#14808080"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── IconPath — vector icon inside a button ─────────────────── -->
    <Style x:Key="IconPath" TargetType="Path">
        <!--
            Fill is not an inherited property, so unlike Foreground above it
            cannot just be left alone. Reading the inherited TextElement.
            Foreground off the Path itself follows exactly the same chain that
            text follows, and works in a Window as well as in a task pane.
        -->
        <!--
            Foreground has to be stated, and it has to work in both hosts.

            Leaving it unset does NOT inherit: WPF's theme style for Button
            sets Foreground, and theme-style setters outrank inheritance, so
            an unset Foreground lands on Aero's dark default and button text
            comes out near-black on a dark Office theme.

            Binding it to an ancestor UserControl works in a task pane and
            fails in a plain Window. PriorityBinding takes whichever resolves:
            the pane's UserControl if there is one, otherwise the Window.
        -->
        <Setter Property="Fill">
            <Setter.Value>
                <PriorityBinding>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </PriorityBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Stretch"       Value="Uniform"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>

</ResourceDictionary>

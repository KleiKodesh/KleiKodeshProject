<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:themes="clr-namespace:WpfLib.Themes"
                    xmlns:ap="clr-namespace:WpfLib.AttachedProperties"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/brushes.xaml"/>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/themedcontrol.xaml"/>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Text entry. Transparent fill, hairline border, accent border on focus.

        Foreground is inherited here rather than bound to an ancestor
        UserControl, so these work in a plain Window as well as in a task pane.

        Colour values are inlined inside the templates. That is the VSTO
        rule: a StaticResource in a ControlTemplate throws when the template is
        instantiated in a separate HwndSource, which a Popup or a ContextMenu is.
        Style setters are outside that rule - they resolve once, when this
        dictionary loads - so they use the named brushes.
    -->

    <Style x:Key="OfficeTextBox" TargetType="TextBox" BasedOn="{StaticResource ThemedControl}">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="6,0"/>
        <Setter Property="MinHeight"        Value="28"/>
        <Setter Property="FontFamily"       Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize"         Value="{StaticResource FontSizeLarge}"/>
        <Setter Property="SelectionBrush"   Value="{StaticResource AccentBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <!--
                                Placeholder - shown only while the box is empty.
                                Behind the content host and never hit testable,
                                so a click still lands in the text.
                            -->
                            <!--
                                HorizontalAlignment, not TextAlignment: a
                                placeholder belongs at the reading start, and
                                only HorizontalAlignment is flow-relative -
                                Left means "start", so it lands on the right
                                in an RTL pane by itself. TextAlignment names
                                a physical side and needs a per-pane override,
                                and a stretched TextBlock with no alignment at
                                all ignores the mirror and stays hard left.
                            -->
                            <TextBlock x:Name="Placeholder"
                                       HorizontalAlignment="Left"
                                       Text="{TemplateBinding ap:Placeholder.Text}"
                                       Foreground="#99808080"
                                       Margin="{TemplateBinding Padding}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#80808080"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless input, for dropping inside a border you draw yourself. -->
    <Style x:Key="FlatTextBox" TargetType="TextBox" BasedOn="{StaticResource OfficeTextBox}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight"       Value="0"/>
    </Style>

    <Style x:Key="OfficePasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource ThemedControl}">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="6,0"/>
        <Setter Property="MinHeight"        Value="28"/>
        <Setter Property="FontFamily"       Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize"         Value="{StaticResource FontSizeLarge}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#80808080"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

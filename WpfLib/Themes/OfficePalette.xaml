<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        OfficePalette — shared style palette for all KleiKodesh task pane libraries.

        Merging this single dictionary gives a library:
          - Type tokens: UiFontFamily, FontSizeSmall/Normal/Large (Typography.xaml)
          - Adaptive brush tokens (Brushes.xaml)
          - Implicit ComboBox + keyed OfficeComboItem (ComboBoxStyles.xaml)
          - Implicit Button + keyed IconButton, IconToggle, AccentToggle,
            CheckedToggle, ActionButton, IconPath (ButtonStyles.xaml)
          - Implicit CheckBox with VSCode-style square tick (CheckBoxStyles.xaml)
          - Implicit ScrollBar — thin Edge-style, no arrows (ScrollBarStyles.xaml)
          - The look of WpfLib's own UpDownTextBox / UpDownFloatTextBox
            (UpDownTextBoxStyles.xaml)

        ToggleButton has no implicit style on purpose: both toggle behaviours are
        legitimate, so a library picks one with a single line of its own —
            <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}"/>
        Sizing lives in the library too; derive with BasedOn and add Width/Height.

        Usage in a library's root dictionary:
            <ResourceDictionary Source="/WpfLib;component/themes/officepalette.xaml"/>

        NOTE: Pack URI paths must be all-lowercase (WPF BAML compiler lowercases them).
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WpfLib;component/themes/typography.xaml"/>
        <ResourceDictionary Source="/WpfLib;component/themes/brushes.xaml"/>
        <ResourceDictionary Source="/WpfLib;component/themes/scrollbarstyles.xaml"/>
        <ResourceDictionary Source="/WpfLib;component/themes/comboboxstyles.xaml"/>
        <ResourceDictionary Source="/WpfLib;component/themes/buttonstyles.xaml"/>
        <ResourceDictionary Source="/WpfLib;component/themes/checkboxstyles.xaml"/>
        <ResourceDictionary Source="/WpfLib;component/themes/updowntextboxstyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>

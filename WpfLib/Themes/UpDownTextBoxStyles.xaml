<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:themes="clr-namespace:WpfLib.Themes"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WpfLib.Controls">
    <ResourceDictionary.MergedDictionaries>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/brushes.xaml"/>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        The look of WpfLib's own numeric text boxes.

        UpDownTextBox and UpDownFloatTextBox are declared in WpfLib/Controls,
        so their appearance belongs here too. Before this file existed, both
        task panes that use them carried a private copy of the same template,
        which meant a third consumer would have had to copy it again.

        These are implicit styles rather than a generic.xaml default style.
        The assembly has no ThemeInfo attribute, and the convention everywhere
        else in this project is "merge OfficePalette", so a control picks up
        its look the same way a Button does.

        All values inlined - no StaticResource inside ControlTemplates (VSTO rule).
    -->

    <!-- Shared look. Keyed on TextBox so both controls can derive from it. -->
    <Style x:Key="UpDownBox" TargetType="TextBox">
        <!--
            Foreground has to be stated, and it has to work in both hosts.

            Leaving it unset does NOT inherit: WPF's theme style for Button
            sets Foreground, and theme-style setters outrank inheritance, so
            an unset Foreground lands on Aero's dark default and button text
            comes out near-black on a dark Office theme.

            Binding it to an ancestor UserControl works in a task pane and
            fails in a plain Window. PriorityBinding takes whichever resolves:
            the pane's UserControl if there is one, otherwise the Window.
        -->
        <Setter Property="Foreground">
            <Setter.Value>
                <PriorityBinding>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </PriorityBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="FontFamily"       Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize"         Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextAlignment"    Value="Center"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="4,0" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#80808080"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:UpDownTextBox"      BasedOn="{StaticResource UpDownBox}"/>
    <Style TargetType="controls:UpDownFloatTextBox" BasedOn="{StaticResource UpDownBox}"/>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WpfLib.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WpfLib;component/themes/typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        The look of WpfLib's own numeric text boxes.

        UpDownTextBox and UpDownFloatTextBox are declared in WpfLib/Controls,
        so their appearance belongs here too. Before this file existed, both
        task panes that use them carried a private copy of the same template,
        which meant a third consumer would have had to copy it again.

        These are implicit styles rather than a generic.xaml default style.
        The assembly has no ThemeInfo attribute, and the convention everywhere
        else in this project is "merge OfficePalette", so a control picks up
        its look the same way a Button does.

        All values inlined - no StaticResource inside ControlTemplates (VSTO rule).
    -->

    <!-- Shared look. Keyed on TextBox so both controls can derive from it. -->
    <Style x:Key="UpDownBox" TargetType="TextBox">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Setter Property="BorderBrush"      Value="#50808080"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="FontFamily"       Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize"         Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextAlignment"    Value="Center"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="4,0" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#80808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:UpDownTextBox"      BasedOn="{StaticResource UpDownBox}"/>
    <Style TargetType="controls:UpDownFloatTextBox" BasedOn="{StaticResource UpDownBox}"/>

</ResourceDictionary>

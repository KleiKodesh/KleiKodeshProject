<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:themes="clr-namespace:WpfLib.Themes"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/themedcontrol.xaml"/>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/brushes.xaml"/>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Controls that group other controls: Expander, GroupBox, TabControl.

        The chevron and the header chrome are shared between Expander and
        TreeViewItem so a collapsible thing looks the same wherever it appears.

        All colour values inlined inside the templates (VSTO rule).
    -->

    <!--
        RTL - which glyphs flip.

        FlowDirection inherits, so a pane that sets RightToLeft mirrors layout
        for free: margins, alignments and grid columns all swap. A Path does
        too, and that is only sometimes wanted, so every Path in this library
        makes a deliberate choice between two classes:

          DIRECTION-AWARE (chevrons, arrows, back/forward) - leave unpinned.
            The glyph MEANS "that way", so it must mirror with reading order.
            A collapsed chevron points at its content in either direction.
            Where such a glyph is also rotated, the mirror reverses the sense
            of the rotation as well, and the two cancel: an expanded chevron
            still lands pointing down. RTL needs no special case.

          PICTORIAL (check, plus, search, product icons) - pin LeftToRight.
            The glyph is a picture of a thing, and a mirrored picture is just
            wrong. IconPath pins for exactly this reason, so every icon that
            derives from it is safe by default.

        The test is the glyph's meaning, never the host's language. Anything
        that needs a per-pane RTL patch belongs in this file instead.

        The same trap catches alignment, and the answer is not symmetric:
        HorizontalAlignment IS flow-relative, so Left means "reading start" and
        lands on the right in an RTL pane by itself. TextAlignment is NOT - it
        names a physical side whatever the flow - and a stretched TextBlock
        with no alignment at all ignores the mirror and stays hard left. So
        anything that should follow the text (a placeholder, a prefix, a hint)
        uses HorizontalAlignment and never TextAlignment.
    -->

    <!-- Standalone rotating chevron, kept for consumers that compose their own
         disclosure headers (none in-tree today - OfficeExpander below inlines
         its own). Not focusable: its focus visual is nulled, so focus here is
         invisible, and a pane that does work when focus arrives must not pay
         that for a disclosure chevron. -->
    <Style x:Key="ChevronToggle" TargetType="ToggleButton" BasedOn="{StaticResource ThemedControl}">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Width"            Value="16"/>
        <Setter Property="Height"           Value="16"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Focusable"        Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="Arrow"
                              Data="M5 3 L9 8 L5 13"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="8" Height="8"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OfficeExpander" TargetType="Expander" BasedOn="{StaticResource ThemedControl}">
        <Setter Property="FontFamily"      Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize"        Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="ContentRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <!-- Not focusable: focus on a disclosure header is
                             invisible here, and a host that does work when
                             focus arrives must not pay it for an expand. -->
                        <ToggleButton x:Name="HeaderToggle"
                                      Grid.Row="0"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Cursor="Hand"
                                      HorizontalContentAlignment="Stretch"
                                      Padding="0,4">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Arrow"
                                                  Grid.Column="0"
                                                  Data="M5 3 L9 8 L5 13"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="8" Height="8"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0A808080"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Grid.Row="1" Margin="18,2,0,6"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentRow" Property="Height" Value="Auto"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        BandedExpander - the same expander with a shaded header band.

        For stacks of expanders, where a tinted full-width header is what
        separates one section from the next. Plain OfficeExpander suits a
        single collapsible block; this suits a pane made of them, which is
        why DocDesign had grown its own copy of exactly this before it moved
        here. Header tint only - everything else is inherited.
    -->
    <Style x:Key="BandedExpander" TargetType="Expander" BasedOn="{StaticResource OfficeExpander}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="ContentRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderBand" Grid.Row="0" Background="#0F808080">
                            <ToggleButton x:Name="HeaderToggle"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False"
                                          FontSize="{StaticResource FontSizeSmall}"
                                          FontWeight="SemiBold"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          HorizontalContentAlignment="Stretch"
                                          Padding="10,7">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Direction-aware: unpinned so it mirrors. -->
                                                <Path x:Name="Arrow"
                                                      Grid.Column="0"
                                                      Data="M5 3 L9 8 L5 13"
                                                      Stroke="{TemplateBinding Foreground}"
                                                      StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Width="8" Height="8"
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0A808080"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </ToggleButton>
                        </Border>
                        <ContentPresenter x:Name="Body" Grid.Row="1" Margin="0,2,0,6"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentRow" Property="Height" Value="Auto"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OfficeGroupBox" TargetType="GroupBox" BasedOn="{StaticResource ThemedControl}">
        <Setter Property="FontFamily"      Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize"        Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,8"/>
        <Setter Property="Margin"          Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0"
                                          ContentSource="Header"
                                          Margin="2,0,0,4"
                                          TextBlock.FontWeight="SemiBold"
                                          Opacity="0.75"/>
                        <Border Grid.Row="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OfficeTabItem" TargetType="TabItem" BasedOn="{StaticResource ThemedControl}">
        <Setter Property="FontFamily"       Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize"         Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Padding"          Value="12,6"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderHost"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <Rectangle x:Name="Underline"
                                   Height="2"
                                   Fill="#0078D4"
                                   VerticalAlignment="Bottom"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline"  Property="Visibility" Value="Visible"/>
                            <Setter TargetName="HeaderHost" Property="TextBlock.FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected"  Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#0A808080"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OfficeTabControl" TargetType="TabControl" BasedOn="{StaticResource ThemedControl}">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource OfficeTabItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="#50808080" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Panel.ZIndex="1"/>
                        </Border>
                        <ContentPresenter Grid.Row="1"
                                          ContentSource="SelectedContent"
                                          Margin="0,8,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Card - a bordered panel grouping related controls.

        A hairline box with a 4px radius and room to breathe, on the same
        mid-grey overlay the rest of the palette uses so it sits correctly on
        any Office theme. The settings pane had its own, drawn with the pane's
        Foreground at 0.85 opacity, which dimmed the card's CONTENTS along with
        its border - Opacity on a Border applies to everything inside it. This
        tints the border alone and leaves the contents at full strength.
    -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource BgSecBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="4"/>
        <Setter Property="Padding"         Value="14,12"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
    </Style>

    <!--
        HoverRow - a clickable row that lights up under the pointer.

        A bare Border rather than a ListBoxItem, because these rows carry their
        own MouseBinding and are not items of a selector. Three panes had each
        written out the same transparent-plus-HoverBrush trigger by hand, seven
        copies between them, which is how the hover tint drifted apart in the
        first place.

        Nothing here sets a size. Rows differ in height and padding, and those
        belong at the call site.
    -->
    <Style x:Key="HoverRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

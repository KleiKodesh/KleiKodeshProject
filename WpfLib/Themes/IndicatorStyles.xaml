<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WpfLib;component/themes/typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Things that report rather than accept input: progress, tooltips, sliders.

        A ToolTip is its own Popup, so it lands in a separate HwndSource. That
        makes it the exact case the VSTO rule is about, and every value in its
        template is inlined. It also has to set its own Background and
        Foreground, because a Popup is outside the pane's visual tree and
        inherits nothing from it.

        All colour values inlined inside the templates (VSTO rule).
    -->

    <Style x:Key="OfficeProgressBar" TargetType="ProgressBar">
        <Setter Property="Height"          Value="4"/>
        <Setter Property="Background"      Value="#1A808080"/>
        <Setter Property="Foreground"      Value="#0078D4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            ClipToBounds="True">
                        <Grid x:Name="Host">
                            <Rectangle x:Name="PART_Track"/>
                            <Rectangle x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}"
                                       RadiusX="2" RadiusY="2"/>
                            <!--
                                Indeterminate needs its own visual. Without it
                                PART_Indicator simply fills the track, and a bar
                                that means "still working" reads as "finished".
                            -->
                            <Rectangle x:Name="Pulse"
                                       Fill="{TemplateBinding Foreground}"
                                       RadiusX="2" RadiusY="2"
                                       Visibility="Collapsed"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Pulse"          Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PulseLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <!--
                                            Scale, not translate. A translate
                                            would need the track width, and a
                                            Binding inside a Storyboard makes
                                            the timeline unfreezable, which
                                            throws XamlParseException the
                                            moment the template is applied.
                                            Scaling from the left edge is
                                            width independent and freezable.
                                        -->
                                        <DoubleAnimation Storyboard.TargetName="Pulse"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0" To="1"
                                                         Duration="0:0:1.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PulseLoop"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OfficeToolTip" TargetType="ToolTip">
        <Setter Property="FontFamily"       Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize"         Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Padding"          Value="8,5"/>
        <Setter Property="HasDropShadow"    Value="False"/>
        <Setter Property="Placement"        Value="Bottom"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#FF2B2B2B"
                            BorderBrush="#FF3F3F3F"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextBlock.Foreground="#FFF0F0F0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OfficeSliderThumb" TargetType="Thumb">
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Knob"
                             Width="12" Height="12"
                             Fill="#0078D4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="#106EBE"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="#005A9E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OfficeSlider" TargetType="Slider">
        <Setter Property="MinHeight"        Value="20"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="3"
                                Background="#1A808080"
                                CornerRadius="2"
                                VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource OfficeSliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:themes="clr-namespace:WpfLib.Themes"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/brushes.xaml"/>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/themedcontrol.xaml"/>
        <themes:SharedResourceDictionary Source="/WpfLib;component/themes/typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        Office-style ComboBox — adaptive, inherits bg/fg from ancestor UserControl.
        All values inlined — no StaticResource inside ControlTemplates (VSTO rule).

        Set Tag to a prompt string to get placeholder text on an editable ComboBox;
        leave Tag unset and the placeholder stays collapsed.
    -->

    <!-- ── ComboBoxItem (shared by all ComboBox styles) ─────────── -->
    <Style x:Key="OfficeComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource ThemedControl}">
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="FontFamily"      Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize"        Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"   Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0A808080"/>
                        </Trigger>
                        <Trigger Property="IsSelected"    Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3300B4FF"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0A808080"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Implicit Office ComboBox (all other ComboBoxes) ───────── -->
    <Style x:Key="OfficeComboBox" TargetType="ComboBox">
        <!--
            Foreground has to be stated, and it has to work in both hosts.

            Leaving it unset does NOT inherit: WPF's theme style for Button
            sets Foreground, and theme-style setters outrank inheritance, so
            an unset Foreground lands on Aero's dark default and button text
            comes out near-black on a dark Office theme.

            Binding it to an ancestor UserControl works in a task pane and
            fails in a plain Window. PriorityBinding takes whichever resolves:
            the pane's UserControl if there is one, otherwise the Window.
        -->
        <Setter Property="Foreground">
            <Setter.Value>
                <PriorityBinding>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </PriorityBinding>
            </Setter.Value>
        </Setter>
        <!--
            Transparent rather than the pane's Background. It used to bind to
            an ancestor UserControl, which is absent in a plain Window: the
            binding failed, so the box fell back to system colours and read as
            light-on-light or dark-on-dark. The drop-down states its own opaque
            surface, so nothing here needs one. (Foreground is the
            PriorityBinding above, for the same two-host reason.)
        -->
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize"        Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Height"          Value="28"/>
        <Setter Property="Padding"         Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing"    Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource OfficeComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <!--
                                    The toggle spans the whole box and sits behind
                                    everything else, so a click anywhere opens the
                                    list rather than only a click on the chevron.

                                    ContentSite and the placeholder are not hit
                                    testable, so their clicks fall through to it.
                                    PART_EditableTextBox IS hit testable and covers
                                    column 0, so on an editable box the text area
                                    takes the caret and only the chevron column
                                    reaches the toggle. That is the behaviour you
                                    want from a combo you can type into.
                                -->
                                <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                              IsChecked="{Binding IsDropDownOpen,
                                                  RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0"
                                              Focusable="False" ClickMode="Press" Cursor="Hand"
                                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"
                                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                                <Path Data="M4 6L8 10L12 6"
                                                      HorizontalAlignment="Right"
                                                      Margin="0,0,7,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="10" Height="6"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      FlowDirection="LeftToRight"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  IsHitTestVisible="False"/>
                                <!-- Placeholder — shown when editable and empty -->
                                <TextBlock x:Name="Placeholder"
                                           Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#99808080"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           Padding="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                         Background="Transparent" BorderThickness="0"
                                         Margin="{TemplateBinding Padding}"
                                         FontSize="{TemplateBinding FontSize}"
                                         FontFamily="{TemplateBinding FontFamily}"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{TemplateBinding Foreground}"
                                         VerticalContentAlignment="Center"
                                         Visibility="Hidden"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" VerticalOffset="4" StaysOpen="False"
                               AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Slide">
                            <!--
                                The drop-down is a Popup, so it renders outside
                                the pane's visual tree. It used to take its
                                Background from the ComboBox, which takes it
                                from an ancestor UserControl - and in a plain
                                Window there is no such ancestor, so the
                                binding produced null and the popup painted
                                BLACK, text and all.

                                A popup has to state its colours; it cannot
                                borrow them through a tree it is not in. It
                                mirrors the host through the same
                                PriorityBinding the controls use, so the list
                                matches the Office theme. System colours were
                                the first attempt and were wrong for exactly
                                that reason: they follow Windows, not Office,
                                so a dark pane got a white list.
                            -->
                            <Border BorderBrush="#50808080"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="0,3"
                                    Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Background>
                                    <PriorityBinding>
                                        <Binding Path="Background" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding Path="Background" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </PriorityBinding>
                                </Border.Background>
                                <TextElement.Foreground>
                                    <PriorityBinding>
                                        <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </PriorityBinding>
                                </TextElement.Foreground>
                                <ScrollViewer SnapsToDevicePixels="True" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    VirtualizingPanel.IsVirtualizing="True"
                                                    VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite"          Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_EditableTextBox"  Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!--
                            Show the placeholder while the box is editable and
                            empty. Without this the TextBlock above stays
                            Collapsed forever, which is what it did for as long
                            as it existed: the markup was there, the trigger
                            never was, so Tag did nothing.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <!--
                                    A property Condition reads the templated
                                    parent, and SourceName reads a named part.
                                    A Binding with RelativeSource Self does
                                    NOT work here: inside a ControlTemplate it
                                    resolves against the template root, not the
                                    ComboBox, so IsEditable never matched and
                                    the placeholder stayed hidden.
                                -->
                                <Condition Property="IsEditable" Value="True"/>
                                <Condition SourceName="PART_EditableTextBox" Property="Text" Value=""/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"     Value="#0078D4"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,2"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#80808080"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"     Value="#0078D4"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1,1,1,2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

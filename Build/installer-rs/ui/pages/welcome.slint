component TutorCard inherits ProductCard {
    id: "tutor";
    title: Installer.products[2].title;
    blurb: Lang.t("שיעורים, מקלדת וידיים על המסך", "Lessons, on-screen keyboard and hands");
    selected: Installer.products[2].selected;
    slides: [{ title: "", shot: Shots.pick({ he-light: @image-url("../images/shots/he/light/tutor.png"), he-dark: @image-url("../images/shots/he/dark/tutor.png"),
                                 en-light: @image-url("../images/shots/en/light/tutor.png"), en-dark: @image-url("../images/shots/en/dark/tutor.png") }) }];
    toggled => { Installer.toggle-product(2); }
}

export component WelcomePage inherits VerticalLayout {
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 14px;
    spacing: 0px;
    PageTitle {
        title: Installer.updating ? Lang.t("עדכון כלי קודש", "Update Klei Kodesh") : Lang.t("התקנת כלי קודש", "Install Klei Kodesh");
        subtitle: Lang.t("סמנו מה להתקין. אפשר להוסיף או להסיר רכיבים בכל זמן.", "Choose what to install. You can add or remove parts at any time.");
    }
    // Release notes are for people updating; a first install has nothing to compare with.
    if Installer.has-notes && Installer.updating: HorizontalLayout {
        alignment: Lang.en ? LayoutAlignment.start : LayoutAlignment.end;
        LinkText {
            text: Lang.t("מה חדש בגרסה ", "What's new in version ") + Installer.version;
            clicked => { Installer.whats-new-back = Page.welcome; Installer.page = Page.whats-new; }
        }
    }
    Rectangle { height: 12px; }
    // Reading order: add-in first (right in Hebrew, left in English).
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        vertical-stretch: 0;
        if Lang.en: AddinCard { }
        if Lang.en: KitveiCard { }
        if Lang.en: TutorCard { }
        if !Lang.en: TutorCard { }
        if !Lang.en: KitveiCard { }
        if !Lang.en: AddinCard { }
    }
    Rectangle { vertical-stretch: 1; min-height: 10px; }
    // Bottom row. Already installed: a clean-install choice (above it a separator);
    // otherwise what will be installed.
    if Installer.updating: Divider { }
    Rectangle { height: 10px; }
    HorizontalLayout {
        spacing: 8px;
        if Lang.en && Installer.updating: VerticalLayout { horizontal-stretch: 1; alignment: center; CheckRow { text: "Clean install (removes settings, caches and indexes first)"; checked: Installer.clean-install; toggled => { Installer.clean-install = !Installer.clean-install; } } }
        if Lang.en && !Installer.updating: Text { horizontal-stretch: 1; text: Installer.summary; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
        if Lang.en: Button { text: "Options…"; min-width: 100px; clicked => { Installer.options-back = Page.welcome; Installer.page = Page.options; } }
        if Lang.en: Button { text: Installer.updating ? "Update" : "Install"; primary: true; min-width: 100px; enabled: Installer.any-selected; clicked => { Installer.install(); } }
        if !Lang.en: Button { text: Installer.updating ? "עדכן" : "התקן"; primary: true; min-width: 100px; enabled: Installer.any-selected; clicked => { Installer.install(); } }
        if !Lang.en: Button { text: "אפשרויות…"; min-width: 100px; clicked => { Installer.options-back = Page.welcome; Installer.page = Page.options; } }
        if !Lang.en && Installer.updating: VerticalLayout { horizontal-stretch: 1; alignment: center; CheckRow { text: "התקנה נקייה (מסיר קודם הגדרות, מטמון ואינדקסים)"; checked: Installer.clean-install; toggled => { Installer.clean-install = !Installer.clean-install; } } }
        if !Lang.en && !Installer.updating: Text { horizontal-stretch: 1; text: Installer.summary; color: Theme.muted; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    }
}

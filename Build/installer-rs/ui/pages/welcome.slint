import { Button, CheckBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Lang } from "../lang.slint";
import { Shots } from "shots.slint";
import { Installer, Page } from "../state.slint";
import { PageTitle, ShotCard, ProductIcon, CheckRow, Divider, LinkText } from "../widgets.slint";

struct Slide { title: string, shot: image }

// One product: checkbox + icon + name on top, screenshot(s) below with a caption.
// More than one slide = a small gallery that cycles, with the current pane's name and dots.
// All screenshots share one size (a Word task pane, 600 x 678 px), shown here at 3:4-ish.
component ProductCard inherits Rectangle {
    in property <string> id;
    in property <string> title;
    in property <string> blurb;
    in property <bool> selected;
    in property <bool> available: true;
    in property <[Slide]> slides;
    property <int> at: 0;
    callback toggled();

    vertical-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    background: Theme.bg;

    // Anywhere on the card toggles it (underneath the content, so the checkbox and
    // gallery still get their own clicks).
    TouchArea {
        enabled: root.available;
        mouse-cursor: root.available ? pointer : default;
        clicked => { root.toggled(); }
    }

    Timer {
        interval: 2600ms;
        running: root.slides.length > 1;
        triggered => { root.at = Math.mod(root.at + 1, root.slides.length); }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            if Lang.en: CheckBox { text: ""; enabled: root.available; checked: root.selected; toggled => { root.toggled(); } }
            if Lang.en: VerticalLayout { alignment: center; ProductIcon { id: root.id; size: 20px; } }
            if Lang.en: Text { text: root.title; color: Theme.text; font-size: 12.5px; font-weight: 600; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if !Lang.en: Text { text: root.title; color: Theme.text; font-size: 12.5px; font-weight: 600; vertical-alignment: center; }
            if !Lang.en: VerticalLayout { alignment: center; ProductIcon { id: root.id; size: 20px; } }
            if !Lang.en: CheckBox { text: ""; enabled: root.available; checked: root.selected; toggled => { root.toggled(); } }
        }
        ShotCard {
            // 600 x 678 shown at 160 x 181: exact ratio, nothing cropped.
            width: 160px;
            height: 181px;
            source: root.slides[root.at].shot;
            opacity: root.selected ? 1 : 0.45;
        }
        Text {
            text: root.slides.length > 1 ? root.slides[root.at].title : root.blurb;
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: Lang.start;
            overflow: elide;
        }
        // Gallery position, centred under the caption (empty row for single shots keeps cards equal).
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            height: 6px;
            for s[i] in (root.slides.length > 1 ? root.slides : []): Rectangle {
                width: i == root.at ? 12px : 5px;
                height: 5px;
                border-radius: 2.5px;
                background: i == root.at ? Theme.accent : Theme.border;
                animate width { duration: 150ms; }
            }
        }
    }
}

component AddinCard inherits ProductCard {
    id: "addin";
    title: Installer.products[0].title;
    available: Installer.products[0].available;
    selected: Installer.products[0].selected;
    slides: [
        { title: Lang.t("כתבי הקודש", "Kitvei Hakodesh"), shot: Shots.pick({ he-light: @image-url("../images/shots/he/light/kitvei-home.png"), he-dark: @image-url("../images/shots/he/dark/kitvei-home.png"),
                                 en-light: @image-url("../images/shots/en/light/kitvei-home.png"), en-dark: @image-url("../images/shots/en/dark/kitvei-home.png") }) },
        { title: Lang.t("עיצוב תורני — פסקאות", "Torah formatting: paragraphs"), shot: Shots.pick({ he-light: @image-url("../images/shots/he/light/pane-docdesign.png"), he-dark: @image-url("../images/shots/he/dark/pane-docdesign.png"),
                                 en-light: @image-url("../images/shots/en/light/pane-docdesign.png"), en-dark: @image-url("../images/shots/en/dark/pane-docdesign.png") }) },
        { title: Lang.t("עיצוב תורני — איזון טורים", "Torah formatting: columns"), shot: Shots.pick({ he-light: @image-url("../images/shots/he/light/pane-docdesign-columns.png"), he-dark: @image-url("../images/shots/he/dark/pane-docdesign-columns.png"),
                                 en-light: @image-url("../images/shots/en/light/pane-docdesign-columns.png"), en-dark: @image-url("../images/shots/en/dark/pane-docdesign-columns.png") }) },
        { title: Lang.t("עיצוב תורני — מרווחים", "Torah formatting: spacing"), shot: Shots.pick({ he-light: @image-url("../images/shots/he/light/pane-docdesign-spacing.png"), he-dark: @image-url("../images/shots/he/dark/pane-docdesign-spacing.png"),
                                 en-light: @image-url("../images/shots/en/light/pane-docdesign-spacing.png"), en-dark: @image-url("../images/shots/en/dark/pane-docdesign-spacing.png") }) },
        { title: Lang.t("ניקוד", "Nakdan"), shot: Shots.pick({ he-light: @image-url("../images/shots/he/light/pane-nakdan.png"), he-dark: @image-url("../images/shots/he/dark/pane-nakdan.png"),
                                 en-light: @image-url("../images/shots/en/light/pane-nakdan.png"), en-dark: @image-url("../images/shots/en/dark/pane-nakdan.png") }) },
        { title: Lang.t("חיפוש רגקס", "Regex search"), shot: Shots.pick({ he-light: @image-url("../images/shots/he/light/pane-regex.png"), he-dark: @image-url("../images/shots/he/dark/pane-regex.png"),
                                 en-light: @image-url("../images/shots/en/light/pane-regex.png"), en-dark: @image-url("../images/shots/en/dark/pane-regex.png") }) },
        { title: Lang.t("דרך האתרים", "Websites"), shot: Shots.pick({ he-light: @image-url("../images/shots/he/light/pane-websites.png"), he-dark: @image-url("../images/shots/he/dark/pane-websites.png"),
                                 en-light: @image-url("../images/shots/en/light/pane-websites.png"), en-dark: @image-url("../images/shots/en/dark/pane-websites.png") }) },
        { title: Lang.t("קיוויקס", "Kiwix"), shot: Shots.pick({ he-light: @image-url("../images/shots/he/light/pane-kiwix.png"), he-dark: @image-url("../images/shots/he/dark/pane-kiwix.png"),
                                 en-light: @image-url("../images/shots/en/light/pane-kiwix.png"), en-dark: @image-url("../images/shots/en/dark/pane-kiwix.png") }) },
    ];
    toggled => { Installer.toggle-product(0); }
}


<Page x:Class="KleiKodeshVstoInstallerWpf.GeneralSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:KleiKodeshVstoInstallerWpf.Properties"
        xmlns:ui="clr-namespace:KleiKodeshVstoInstallerWpf"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#FFFFFF"
      FlowDirection="{x:Static ui:UiLanguage.FlowDirection}"
      FontFamily="Segoe UI">

    <Page.Resources>
        <!-- PrimaryButton -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#7333FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5E1FE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A0FD4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- SecondaryButton -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground"      Value="#5A5A5A"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#1F1F1F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- GhostButton -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground"      Value="#5A5A5A"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F000000"/>
                                <Setter Property="Foreground" Value="#1F1F1F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- AccentProgress -->
        <Style x:Key="AccentProgress" TargetType="ProgressBar">
            <Setter Property="Height"          Value="3"/>
            <Setter Property="Foreground"      Value="#7333FF"/>
            <Setter Property="Background"      Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="auto"/>  <!-- sticky header -->
            <RowDefinition Height="*"/>     <!-- scrollable settings -->
            <RowDefinition Height="auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Top accent bar -->
        <Border Grid.Row="0" Background="#7333FF"/>

        <!-- Sticky header -->
        <StackPanel Grid.Row="1" Margin="28,22,28,10">
            <TextBlock Text="{x:Static p:Strings.Settings_General_Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1F1F1F"/>
            <TextBlock Text="{x:Static p:Strings.Settings_General_Subtitle}"
                       FontSize="13"
                       Foreground="#5A5A5A"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Scrollable settings -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,0,28,16">

                <!-- Section: UI language (General/UiLanguage, shared with the Word add-in) -->
                <TextBlock Text="{x:Static p:Strings.Settings_Language}"
                           FontSize="11"
                           Foreground="#5A5A5A"
                           Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="RadioButton">
                            <Setter Property="Margin"                  Value="0,0,16,0"/>
                            <Setter Property="FontSize"                Value="13"/>
                            <Setter Property="Foreground"              Value="#1F1F1F"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Cursor"                  Value="Hand"/>
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton x:Name="HebrewLanguageRadio"  GroupName="UiLanguage" Content="&#x05E2;&#x05D1;&#x05E8;&#x05D9;&#x05EA;"/>
                    <RadioButton x:Name="EnglishLanguageRadio" GroupName="UiLanguage" Content="English"/>
                </StackPanel>
                <TextBlock Text="{x:Static p:Strings.Settings_LanguageHint}"
                           FontSize="11"
                           Foreground="#888888"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>

                <!-- Divider -->
                <Border Height="1" Background="#E5E5E5" Margin="0,12,0,12"/>

                <!-- Section: optional VBA macros template (KleiKodeshVsto/Helpers/VbaMacrosTemplate.cs).
                     Texts come from that shared class, set in code. -->
                <TextBlock x:Name="MacrosHeader"
                           FontSize="11"
                           Foreground="#5A5A5A"
                           Margin="0,0,0,6"/>
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="RadioButton">
                            <Setter Property="Margin"                  Value="0,0,0,6"/>
                            <Setter Property="FontSize"                Value="13"/>
                            <Setter Property="Foreground"              Value="#1F1F1F"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Cursor"                  Value="Hand"/>
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton x:Name="MacrosNoneRadio"    GroupName="VbaMacros"/>
                    <RadioButton x:Name="MacrosHebrewRadio"  GroupName="VbaMacros"/>
                    <RadioButton x:Name="MacrosEnglishRadio" GroupName="VbaMacros"/>
                </StackPanel>
                <TextBlock x:Name="MacrosHint"
                           FontSize="11"
                           Foreground="#888888"
                           TextWrapping="Wrap"/>

                <!-- Divider -->
                <Border Height="1" Background="#E5E5E5" Margin="0,12,0,12"/>

                <!-- Section: shell integration -->
                <TextBlock Text="{x:Static p:Strings.Adv_FileExplorer}"
                           FontSize="11"
                           Foreground="#5A5A5A"
                           Margin="0,0,0,6"/>

                <CheckBox x:Name="ShellRegisterCheckBox"
                          Content="{x:Static p:Strings.Adv_OpenWith}"
                          FontSize="13"
                          Foreground="#1F1F1F"
                          Margin="0,0,0,6"
                          Checked="ShellRegisterCheckBox_Changed"
                          Unchecked="ShellRegisterCheckBox_Changed"/>
                <TextBlock Text="{x:Static p:Strings.Adv_OpenWithHint}"
                           FontSize="11"
                           Foreground="#5A5A5A"
                           Opacity="0.7"
                           Margin="20,0,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="#F0F0F0"
                BorderBrush="#E5E5E5"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BackButton"
                            Content="{x:Static p:Strings.Back}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,4,0"
                            Click="BackButton_Click"/>
                    <Button x:Name="CloseButton"
                            Content="{x:Static p:Strings.Close}"
                            Style="{StaticResource GhostButton}"
                            Click="CloseButton_Click"/>
                </StackPanel>

                <Button x:Name="NextButton"
                        Grid.Column="2"
                        Content="{x:Static p:Strings.Next}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,4,0"
                        Click="NextButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>

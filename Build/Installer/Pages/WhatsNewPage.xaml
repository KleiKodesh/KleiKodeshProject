<Page x:Class="KleiKodeshVstoInstallerWpf.WhatsNewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:p="clr-namespace:KleiKodeshVstoInstallerWpf.Properties"
      xmlns:ui="clr-namespace:KleiKodeshVstoInstallerWpf"
      Background="#FFFFFF"
      FlowDirection="{x:Static ui:UiLanguage.FlowDirection}"
      FontFamily="Segoe UI">

    <Page.Resources>
        <ResourceDictionary Source="/Resources/InstallerStyles.xaml"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="auto"/>  <!-- header -->
            <RowDefinition Height="*"/>     <!-- release notes -->
            <RowDefinition Height="auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Top accent bar -->
        <Border Grid.Row="0" Background="#7333FF"/>

        <StackPanel Grid.Row="1" Margin="28,22,28,10">
            <TextBlock Text="{x:Static p:Strings.WhatsNew_Title}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1F1F1F"/>
        </StackPanel>

        <!-- Read-only notes; FlowDirection follows the notes' language (set in code). -->
        <FlowDocumentScrollViewer x:Name="NotesViewer"
                                  Grid.Row="2"
                                  Margin="22,0,22,12"
                                  IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"/>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="#F0F0F0"
                BorderBrush="#E5E5E5"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CloseButton"
                        Grid.Column="0"
                        Content="{x:Static p:Strings.Close}"
                        Style="{StaticResource GhostButton}"
                        Click="CloseButton_Click"/>

                <Button x:Name="ContinueButton"
                        Grid.Column="2"
                        Content="{x:Static p:Strings.WhatsNew_Continue}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,4,0"
                        Click="ContinueButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>

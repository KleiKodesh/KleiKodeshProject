<Page x:Class="KleiKodeshVstoInstallerWpf.ComponentSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#FFFFFF"
      FlowDirection="RightToLeft"
      FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#7333FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5E1FE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A0FD4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground"      Value="#5A5A5A"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#1F1F1F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="auto"/>  <!-- header -->
            <RowDefinition Height="*"/>     <!-- scrollable content -->
            <RowDefinition Height="auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Accent bar -->
        <Border Grid.Row="0" Background="#7333FF"/>

        <!-- Header -->
        <StackPanel Grid.Row="1" Margin="28,22,28,10">
            <TextBlock Text="הגדרות מתקדמות"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1F1F1F"/>
            <TextBlock Text="הגדרות נוספות לרכיבים שבחרת"
                       FontSize="13"
                       Foreground="#5A5A5A"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,0,28,16">

                <!-- ── KitveiHakodesh DB section ─────────────────────────────── -->
                <StackPanel x:Name="KitveiHakodeshSection">

                    <TextBlock Text="כתבי הקודש"
                               FontSize="11"
                               Foreground="#5A5A5A"
                               Margin="0,0,0,6"/>

                    <Button x:Name="ZayitDbButton"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            Cursor="Hand"
                            Click="ZayitDbButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="#F8F8F8"/>
                                <Setter Property="BorderBrush"     Value="#E5E5E5"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="10,0">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#7333FF"/>
                                                    <Setter TargetName="Bd" Property="Background"  Value="#F5F0FF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#EDE5FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0"
                                     Width="14" Height="14"
                                     Margin="0,0,8,0"
                                     FlowDirection="LeftToRight"
                                     VerticalAlignment="Center">
                                <Path Data="M1,3 L1,11 L13,11 L13,4 L7,4 L5.5,2 L1,2 Z M13,4 L7,4"
                                      Stroke="#5A5A5A" StrokeThickness="1"
                                      Fill="Transparent" StrokeLineJoin="Round"/>
                            </Viewbox>
                            <TextBlock x:Name="DbPathText"
                                       Grid.Column="1"
                                       Text="ברירת מחדל"
                                       FontSize="11"
                                       Foreground="#5A5A5A"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <TextBlock x:Name="DbHintText"
                               FontSize="11"
                               Foreground="#5A5A5A"
                               Opacity="0.7"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>
                <!-- /KitveiHakodeshSection -->


                <!-- ── HebrewBooks local folder section ──────────────────────── -->
                <StackPanel x:Name="HebrewBooksSection" Margin="0,12,0,0">

                    <TextBlock Text="היברו בוקס"
                               FontSize="11"
                               Foreground="#5A5A5A"
                               Margin="0,0,0,6"/>

                    <Button x:Name="HbLocalFolderButton"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            Cursor="Hand"
                            Click="HbLocalFolderButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="#F8F8F8"/>
                                <Setter Property="BorderBrush"     Value="#E5E5E5"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="10,0">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#7333FF"/>
                                                    <Setter TargetName="Bd" Property="Background"  Value="#F5F0FF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#EDE5FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0"
                                     Width="14" Height="14"
                                     Margin="0,0,8,0"
                                     FlowDirection="LeftToRight"
                                     VerticalAlignment="Center">
                                <Path Data="M1,3 L1,11 L13,11 L13,4 L7,4 L5.5,2 L1,2 Z M13,4 L7,4"
                                      Stroke="#5A5A5A" StrokeThickness="1"
                                      Fill="Transparent" StrokeLineJoin="Round"/>
                            </Viewbox>
                            <TextBlock x:Name="HbLocalFolderText"
                                       Grid.Column="1"
                                       Text="לא הוגדר — יוריד לאחסון זמני"
                                       FontSize="11"
                                       Foreground="#5A5A5A"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <TextBlock x:Name="HbLocalFolderHintText"
                               FontSize="11"
                               Foreground="#5A5A5A"
                               Opacity="0.7"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="תיקייה שבה מאוחסנים קובצי PDF — אם הספר נמצא שם לא יוריד"/>

                </StackPanel>
                <!-- /HebrewBooksSection -->
                <!-- Hidden spacer — keeps SectionDivider name for code-behind -->
                <Border x:Name="SectionDivider" Height="0"/>

                <!-- ── Websites section ───────────────────────────────── -->
                <StackPanel x:Name="WebsitesSection">

                    <TextBlock Text="דרך האתרים"
                               FontSize="11"
                               Foreground="#5A5A5A"
                               Margin="0,12,0,6"/>

                    <Button x:Name="EditWhitelistButton"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            Cursor="Hand"
                            Click="EditWhitelistButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="#F8F8F8"/>
                                <Setter Property="BorderBrush"     Value="#E5E5E5"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="10,0">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#7333FF"/>
                                                    <Setter TargetName="Bd" Property="Background"  Value="#F5F0FF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#EDE5FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0"
                                     Width="14" Height="14"
                                     Margin="0,0,8,0"
                                     FlowDirection="LeftToRight"
                                     VerticalAlignment="Center">
                                <Path Data="M16.417 9.57a7.917 7.917 0 1 1-8.144-7.908 1.758 1.758 0 0 1 .451 0 7.913 7.913 0 0 1 7.693 7.907zM5.85 15.838q.254.107.515.193a11.772 11.772 0 0 1-1.572-5.92h-3.08a6.816 6.816 0 0 0 4.137 5.727zM2.226 6.922a6.727 6.727 0 0 0-.511 2.082h3.078a11.83 11.83 0 0 1 1.55-5.89q-.249.083-.493.186a6.834 6.834 0 0 0-3.624 3.622zm8.87 2.082a14.405 14.405 0 0 0-.261-2.31 9.847 9.847 0 0 0-.713-2.26c-.447-.952-1.009-1.573-1.497-1.667a8.468 8.468 0 0 0-.253 0c-.488.094-1.05.715-1.497 1.668a9.847 9.847 0 0 0-.712 2.26 14.404 14.404 0 0 0-.261 2.309zm-.974 5.676a9.844 9.844 0 0 0 .713-2.26 14.413 14.413 0 0 0 .26-2.309H5.903a14.412 14.412 0 0 0 .261 2.31 9.844 9.844 0 0 0 .712 2.259c.487 1.036 1.109 1.68 1.624 1.68s1.137-.644 1.623-1.68zm4.652-2.462a6.737 6.737 0 0 0 .513-2.107h-3.082a11.77 11.77 0 0 1-1.572 5.922q.261-.086.517-.194a6.834 6.834 0 0 0 3.624-3.621zM11.15 3.3a6.82 6.82 0 0 0-.496-.187 11.828 11.828 0 0 1 1.55 5.89h3.081A6.815 6.815 0 0 0 11.15 3.3z"
                                      Fill="#5A5A5A"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="ערוך רשימת אתרים מותרים"
                                       FontSize="12"
                                       Foreground="#1F1F1F"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <TextBlock Text="בחר אילו אתרים יופיעו בסרגל הכלים"
                               FontSize="11"
                               Foreground="#5A5A5A"
                               Opacity="0.7"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>
                <!-- /WebsitesSection -->

                <!-- ── Shell integration section — always last ────────────────── -->
                <TextBlock Text="סייר הקבצים"
                           FontSize="11"
                           Foreground="#5A5A5A"
                           Margin="0,12,0,6"/>

                <CheckBox x:Name="ShellRegisterCheckBox"
                          Content="הוסף את כתבי הקודש לתפריט 'פתיחה עם' של המערכת"
                          FontSize="13"
                          Foreground="#1F1F1F"
                          Margin="0,0,0,6"
                          Checked="ShellRegisterCheckBox_Changed"
                          Unchecked="ShellRegisterCheckBox_Changed"/>
                <TextBlock Text="מאפשר לפתוח קבצי PDF, Word ועוד ישירות בכתבי הקודש מסייר הקבצים"
                           FontSize="11"
                           Foreground="#5A5A5A"
                           Opacity="0.7"
                           Margin="20,0,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="#F0F0F0"
                BorderBrush="#E5E5E5"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Content="חזור"
                        Style="{StaticResource SecondaryButton}"
                        Click="BackButton_Click"/>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Content="סגור"
                        Style="{StaticResource PrimaryButton}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>


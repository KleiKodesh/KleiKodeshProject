<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Version>9.0.2</Version>
    <ApplicationIcon>KleiKodesh_Main.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU</Platforms>
    <!--
      Win32 version-resource fields the UAC consent dialog reads. Windows shows
      AssemblyTitle (→ FileDescription) as the bold program name and Company as the
      publisher line; with nothing set the SDK defaults both to the assembly name,
      which is why the prompt used to read "KleiKodeshVstoInstallerWpf" in English.
      Keep these Hebrew so the elevation prompt is recognisable to the user.

      NOTE: the publisher line only reads "כלי קודש" for an unsigned exe, where Windows
      renders it as an unverified publisher. Once the exe is Authenticode-signed, that
      line comes from the certificate subject instead and this value is ignored.
    -->
    <AssemblyTitle>כלי קודש</AssemblyTitle>
    <Product>כלי קודש</Product>
    <Company>כלי קודש</Company>
    <Description>התקנת כלי קודש</Description>
    <!-- Prevent dependency DLLs from being copied to output — they are embedded as resources -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- See the SharpCompress PackageReference below for why this advisory does not apply. -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <!-- Installer variant — set by build script via -p:InstallerVariant=x64|x86|AnyCPU.
       Baked into the binary so SaveVersion() can record which variant was installed. -->
  <PropertyGroup Condition="'$(InstallerVariant)' == 'x64'">
    <DefineConstants>$(DefineConstants);INSTALLER_VARIANT_X64</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InstallerVariant)' == 'x86'">
    <DefineConstants>$(DefineConstants);INSTALLER_VARIANT_X86</DefineConstants>
  </PropertyGroup>
  <!-- AnyCPU (default) — no extra define needed; AddinInstaller falls through to "AnyCPU" -->

  <!-- DeleteFtsIndex — set by build script via -p:DeleteFtsIndex=true.
       When set, the installer deletes the FTS index directory before extracting
       the VSTO package, forcing a full reindex on every user's machine. -->
  <PropertyGroup Condition="'$(DeleteFtsIndex)' == 'true'">
    <DefineConstants>$(DefineConstants);DELETE_FTS_INDEX</DefineConstants>
  </PropertyGroup>

  <!-- ForceCleanInstall — set by build script via -p:ForceCleanInstall=true.
       When set, the installer runs a full repair/cleanup on launch before installing,
       so the "התקן" button behaves like "תיקון" (wipe + fresh install). -->
  <PropertyGroup Condition="'$(ForceCleanInstall)' == 'true'">
    <DefineConstants>$(DefineConstants);FORCE_CLEAN_INSTALL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="KleiKodesh_Main.ico" />
  </ItemGroup>

  <!-- Prebuild: build KleiKodeshVsto and pack KleiKodesh.zip — runs in both Debug and Release -->
  <Target Name="BuildVstoAndPack" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <KleiKodeshProject>$(MSBuildProjectDirectory)\..\..\KleiKodeshVsto\KleiKodeshVsto.csproj</KleiKodeshProject>
      <!-- In Release use Release|AnyCPU (or overrides from build script); in Debug use Debug|AnyCPU -->
      <VstoConfig Condition="'$(Configuration)' == 'Release' AND '$(VstoConfiguration)' != ''">$(VstoConfiguration)</VstoConfig>
      <VstoConfig Condition="'$(Configuration)' == 'Release' AND '$(VstoConfiguration)' == ''">Release</VstoConfig>
      <VstoConfig Condition="'$(Configuration)' != 'Release'">Debug</VstoConfig>
      <VstoPlatformParam Condition="'$(VstoPlatform)' != ''">$(VstoPlatform)</VstoPlatformParam>
      <VstoPlatformParam Condition="'$(VstoPlatform)' == ''">AnyCPU</VstoPlatformParam>
      <!-- Output path matches the platform-specific PropertyGroups in KleiKodeshVsto.csproj -->
      <VstoOutputPath Condition="'$(VstoPlatformParam)' == 'x64'">$(MSBuildProjectDirectory)\..\..\KleiKodeshVsto\bin\$(VstoConfig)-x64</VstoOutputPath>
      <VstoOutputPath Condition="'$(VstoPlatformParam)' == 'x86'">$(MSBuildProjectDirectory)\..\..\KleiKodeshVsto\bin\$(VstoConfig)-x86</VstoOutputPath>
      <VstoOutputPath Condition="'$(VstoOutputPath)' == ''">$(MSBuildProjectDirectory)\..\..\KleiKodeshVsto\bin\$(VstoConfig)</VstoOutputPath>
      <TempPackageDir>$(OutputPath)VstoPackage</TempPackageDir>
      <ZipOutputPath>$(MSBuildProjectDirectory)\KleiKodesh.pkg</ZipOutputPath>
      <PayloadPackerProject>$(MSBuildProjectDirectory)\..\PayloadPacker\PayloadPacker.csproj</PayloadPackerProject>
      <PayloadPackerExe>$(MSBuildProjectDirectory)\..\PayloadPacker\bin\Release\net48\PayloadPacker.exe</PayloadPackerExe>
      <InstallProgressFile>$(MSBuildProjectDirectory)\Helpers\AddinInstaller.cs</InstallProgressFile>
    </PropertyGroup>

    <PropertyGroup>
      <MSBuildPath Condition="Exists('C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\MSBuild.exe')">C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\MSBuild.exe</MSBuildPath>
      <MSBuildPath Condition="'$(MSBuildPath)' == '' AND Exists('C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Current\Bin\MSBuild.exe')">C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Current\Bin\MSBuild.exe</MSBuildPath>
      <MSBuildPath Condition="'$(MSBuildPath)' == '' AND Exists('C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Current\Bin\MSBuild.exe')">C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Current\Bin\MSBuild.exe</MSBuildPath>
      <MSBuildPath Condition="'$(MSBuildPath)' == '' AND Exists('C:\Program Files\Microsoft Visual Studio\2022\Enterprise\MSBuild\Current\Bin\MSBuild.exe')">C:\Program Files\Microsoft Visual Studio\2022\Enterprise\MSBuild\Current\Bin\MSBuild.exe</MSBuildPath>
    </PropertyGroup>

    <Message Text="Building KleiKodeshVsto in $(VstoConfig)|$(VstoPlatformParam)..." Importance="high" />
    <Exec Command="&quot;$(MSBuildPath)&quot; &quot;$(KleiKodeshProject)&quot; /p:Configuration=$(VstoConfig) /p:Platform=$(VstoPlatformParam)" ContinueOnError="false" />

    <Delete Files="$(ZipOutputPath)" Condition="Exists('$(ZipOutputPath)')" />
    <MakeDir Directories="$(TempPackageDir)" />

    <ItemGroup>
      <VstoFiles Include="$(VstoOutputPath)\**\*.*" Exclude="$(VstoOutputPath)\BloomFilters\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(VstoFiles)" DestinationFolder="$(TempPackageDir)\%(RecursiveDir)" />

    <!--
      The payload is packed here with SOLID LZMA into KleiKodesh.pkg, and NSIS is set
      to `SetCompressor zlib` so it does NOT compress it again.

      Why not a zip: the installer's launch time was dominated by NSIS decompressing
      the payload to %TEMP% *before* the WPF window could appear (~7.6 s on a 153 MB
      payload). Pre-compressing here turns the NSIS step into a near-straight byte
      copy (~0.9 s to a visible window) and moves the decompression into the install
      phase, behind the existing progress bar. .NET Framework 4.8's ZipArchive only
      reads Stored and Deflate, and per-entry Deflate cannot dedupe across files —
      measured 48.7 MB versus 33.0 MB for solid LZMA on this payload.

      The packer is a separate net48 project so it uses the SAME SharpCompress build
      the installer embeds; a framing disagreement between writer and reader would
      only surface on a user's machine.
    -->
    <Message Text="Building payload packer..." Importance="high" />
    <Exec Command="dotnet build &quot;$(PayloadPackerProject)&quot; -c Release -v quiet --nologo" ContinueOnError="false" />

    <Message Text="Packing VSTO payload (solid LZMA)..." Importance="high" />
    <Exec Command="&quot;$(PayloadPackerExe)&quot; &quot;$(TempPackageDir)&quot; &quot;$(ZipOutputPath)&quot;" ContinueOnError="false" />

    <RemoveDir Directories="$(TempPackageDir)" />
    <Message Text="VSTO package ready: $(ZipOutputPath)" Importance="high" />
  </Target>

  <ItemGroup>
    <!--
      KleiKodesh.pkg is deliberately NOT embedded. The NSIS wrapper writes it next
      to this exe in %TEMP%, and AddinInstaller.OpenPayloadStream() reads it from
      there. Embedding it would put the whole payload back inside the exe, which is
      exactly what made NSIS spend ~7.6 s decompressing before the window appeared.
      OpenPayloadStream still falls back to an embedded resource of the same name,
      so a standalone exe keeps working if one is ever produced.
    -->
    <EmbeddedResource Include="..\..\KleiKodeshVsto\WebSitesLib\WebSitesLib\WebSitesWhitelist.json">
      <LogicalName>KleiKodeshVstoInstallerWpf.WebSitesWhitelist.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!--
      Version pinned. The EmbedDependencies target below turns this into an embedded
      resource loaded via Assembly.Load(byte[]) (see App.xaml.cs), a path with no
      binding-redirect support — so the facade versions SharpCompress was compiled
      against have to match exactly at runtime. 0.30.1 is verified working through
      that loader with System.Memory 4.5.4 and System.Runtime.CompilerServices.Unsafe
      4.5.3. Do not bump without re-testing extraction end to end.

      NU1902 (GHSA-6c8g-7p36-r338) is suppressed: it covers path traversal in
      SharpCompress's archive readers. This code only uses LZipStream (a raw
      compression stream, no entry paths) and reads its own PayloadArchive format.
    -->
    <PackageReference Include="SharpCompress" Version="0.30.1" />

    <!--
      SharpCompress declares System.Text.Encoding.CodePages for its archive readers
      (legacy zip/rar filename code pages). Nothing here reads archives — only
      LZipStream, which has no filenames — so the package is excluded outright rather
      than merely skipped at embed time. See UnusedFacades in EmbedDependencies below.
    -->
    <PackageReference Update="System.Text.Encoding.CodePages" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <!-- Embed all dependency DLLs into the exe as resources -->
  <Target Name="EmbedDependencies" AfterTargets="ResolveReferences">
    <PropertyGroup>
      <!--
        Transitive packages SharpCompress pulls in but never actually binds against.
        Verified by loading it and reading GetReferencedAssemblies(): it names only
        System.Memory, System.Buffers and System.Runtime.CompilerServices.Unsafe.

        System.Text.Encoding.CodePages (759 KB) is used by SharpCompress's ARCHIVE
        READERS to decode legacy zip/rar filename code pages. This installer only uses
        LZipStream, a raw compression stream with no filenames, so it is never touched
        — confirmed by tracing AssemblyResolve across a full 588-file extraction.
        System.Numerics.Vectors (116 KB) is the same story via System.Memory on net48.

        Together they are 874 KB of an otherwise ~1.6 MB dependency set. If SharpCompress
        is ever used for real archive formats here, drop the relevant name from this list.
      -->
      <UnusedFacades>|System.Text.Encoding.CodePages|System.Numerics.Vectors|</UnusedFacades>
    </PropertyGroup>
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</LogicalName>
      </EmbeddedResource>

      <!--
        NuGet assemblies have to be picked up separately. CopyLocalLockFileAssemblies
        is false above (so nothing lands next to the exe), and that also leaves
        ReferenceCopyLocalPaths empty for package references — so the loop above sees
        SharpCompress and its facades as nothing at all. Without this, the build
        succeeds and the installer then throws FileNotFoundException for
        'SharpCompress' the moment extraction starts, on the user's machine.

        RuntimeCopyLocalItems — NOT ReferencePath — is what must be embedded here.
        ReferencePath resolves to each package's ref/ assembly: a metadata-only stub
        with [ReferenceAssembly] on it. Those compile fine and then die at runtime with
        "Cannot load a reference assembly for execution" the first time Assembly.Load
        touches one. System.Runtime.CompilerServices.Unsafe, System.Buffers and
        System.Numerics.Vectors all ship ref/ and lib/ variants and hit exactly that.
        RuntimeCopyLocalItems carries the lib/ implementations.
      -->
      <EmbeddedResource Include="@(RuntimeCopyLocalItems)"
                        Condition="'%(RuntimeCopyLocalItems.Extension)' == '.dll'
                                   AND !$(UnusedFacades.Contains('|%(RuntimeCopyLocalItems.Filename)|'))">
        <LogicalName>%(RuntimeCopyLocalItems.Filename)%(RuntimeCopyLocalItems.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>